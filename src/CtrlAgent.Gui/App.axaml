<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CtrlAgent.Gui.App"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <FluentTheme />

    <!-- ==== CtrlAgent design system: deep-space glass + neon cyan ==== -->

    <!-- Deep-space field: a near-black canvas with one soft cyan bloom
         drifting through it. Calm, with depth — nothing competes with the
         content sitting on top. -->
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif" />
      <Setter Property="Background">
        <Setter.Value>
          <RadialGradientBrush Center="22%,8%" GradientOrigin="22%,8%" RadiusX="95%" RadiusY="85%">
            <GradientStop Color="#0E1A2E" Offset="0" />
            <GradientStop Color="#080E1A" Offset="0.55" />
            <GradientStop Color="#04060B" Offset="1" />
          </RadialGradientBrush>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Section labels whisper: neutral slate, wide tracking. Cyan is
         reserved for things that are actually live. -->
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="LetterSpacing" Value="2.2" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="#6B84AD" />
    </Style>

    <!-- Surfaces, not boxes: a barely-there lift off the field with a
         hairline top edge, generous curvature, and a soft ambient shadow.
         No hard borders anywhere. -->
    <Style Selector="Border.card">
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#8A16233C" Offset="0" />
            <GradientStop Color="#8A0D1524" Offset="1" />
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="BorderBrush" Value="#14FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="BoxShadow" Value="inset 0 1 0 0 #1FFFFFFF, 0 10 34 0 #73000000" />
    </Style>

    <!-- Alert card variant: amber glow for approvals -->
    <Style Selector="Border.alert">
      <Setter Property="Background" Value="#2EFFA020" />
      <Setter Property="BorderBrush" Value="#80FFB020" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BoxShadow" Value="0 0 28 0 #33FFA020" />
    </Style>

    <!-- ==== Buttons: frosted glass over the dark field ====
         Valve's Big Picture confidence (dark, quiet surfaces with a focus
         state you cannot miss) fused with Apple's material language:
         translucent glass fills, hairline light borders, continuous
         curves, and a press that physically gives. One system, every
         window. -->
    <Style Selector="Button">
      <Setter Property="Foreground" Value="#E8F1FF" />
      <Setter Property="BorderBrush" Value="#1FFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#B31E2B48" Offset="0" />
            <GradientStop Color="#B3141E36" Offset="1" />
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" />
        </Transitions>
      </Setter>
      <!-- Custom template so every button is lit like a piece of hardware:
           a specular hairline catching light along the top edge, and a power
           rail along the bottom that ignites on hover/focus. Together they
           give the surface thickness — the thing flat fills never have.
           PART_ContentPresenter keeps its name and template bindings, so all
           the class variants below still restyle it exactly as before. -->
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
            <!-- Specular: light falling on the top bevel -->
            <Border Name="Specular"
                    Height="1"
                    Margin="7,1,7,0"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False"
                    Opacity="0.5">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                  <GradientStop Color="#00FFFFFF" Offset="0" />
                  <GradientStop Color="#99FFFFFF" Offset="0.5" />
                  <GradientStop Color="#00FFFFFF" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                </Transitions>
              </Border.Transitions>
            </Border>
            <!-- Power rail: dim at rest, full under pointer or focus -->
            <Border Name="EdgeLight"
                    Height="2"
                    Margin="7,0"
                    VerticalAlignment="Bottom"
                    IsHitTestVisible="False"
                    Opacity="0.55">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                  <GradientStop Color="#0000D4FF" Offset="0" />
                  <GradientStop Color="#3300D4FF" Offset="0.18" />
                  <GradientStop Color="#F27DD3FC" Offset="0.5" />
                  <GradientStop Color="#3300D4FF" Offset="0.82" />
                  <GradientStop Color="#0000D4FF" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                </Transitions>
              </Border.Transitions>
            </Border>
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>
    <!-- The rail ignites under the pointer and for keyboard/controller focus -->
    <Style Selector="Button:pointerover /template/ Border#EdgeLight">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button:focus-visible /template/ Border#EdgeLight">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button:pressed /template/ Border#EdgeLight">
      <Setter Property="Opacity" Value="0.15" />
    </Style>
    <!-- Micro-interaction: buttons compress slightly on press -->
    <Style Selector="Button:pressed">
      <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <!-- Hover/press states glide instead of snapping -->
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#CC2A3A5E" Offset="0" />
            <GradientStop Color="#CC1C2A48" Offset="1" />
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="BorderBrush" Value="#8C7DD3FC" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E0101A30" />
      <Setter Property="BorderBrush" Value="#B37DD3FC" />
    </Style>

    <!-- Primary action: the one vivid element on the surface -->
    <!-- The primary action breathes, so the eye lands on it without it ever
         demanding attention. Targets the templated presenter because BoxShadow
         is not a property of Button itself. -->
    <Style Selector="Button.accent:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
      <Style.Animations>
        <Animation Duration="0:0:3.4" IterationCount="Infinite" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="BoxShadow" Value="0 0 12 0 #3300D4FF" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="BoxShadow" Value="0 0 26 0 #7A00D4FF" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="BoxShadow" Value="0 0 12 0 #3300D4FF" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Foreground" Value="#03101E" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderBrush" Value="#59FFFFFF" />
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#33E1FF" Offset="0" />
            <GradientStop Color="#00D4FF" Offset="0.45" />
            <GradientStop Color="#3B82F6" Offset="1" />
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- A cyan rail on a cyan button is invisible; the accent gets a bright
         white filament instead, so it still reads as the same system. -->
    <Style Selector="Button.accent /template/ Border#EdgeLight">
      <Setter Property="Opacity" Value="0.5" />
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#00FFFFFF" Offset="0" />
            <GradientStop Color="#E6FFFFFF" Offset="0.5" />
            <GradientStop Color="#00FFFFFF" Offset="1" />
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#3FE4FF" Offset="0" />
            <GradientStop Color="#12D9FF" Offset="0.45" />
            <GradientStop Color="#4489F7" Offset="1" />
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="BorderBrush" Value="#8CFFFFFF" />
    </Style>

    <!-- Ghost: window-level tools (Mainframe, Overlay, Profile…). These
         are always present, so they must never read as loud as the action
         row. No fill and no border at rest — the material only materializes
         under the pointer, the way a macOS toolbar item does. -->
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#3D101A2E" />
      <Setter Property="BorderBrush" Value="#14FFFFFF" />
      <Setter Property="Foreground" Value="#93A9CC" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="11,6" />
    </Style>
    <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <!-- Session knob: a pill in the status strip that both reports a value
         and steps it. Sized down so four of them read as one instrument
         cluster next to the facts rather than as four commands. -->
    <Style Selector="Button.knob">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Segmented toolbar item: lives inside a rail that already supplies the
         chrome, so the item itself is bare until hovered. Squarer corners than
         a standalone button because it is one cell of a strip. -->
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="#A8BEDE" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="11,5" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="Button.tool /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#6622334F" />
      <Setter Property="TextElement.Foreground" Value="#EAF3FF" />
    </Style>
    <Style Selector="Button.tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#800C1424" />
    </Style>
    <!-- The rail is the chrome; per-item edge lighting would fight it. -->
    <Style Selector="Button.tool /template/ Border#Specular">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.tool /template/ Border#EdgeLight">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ Border#EdgeLight">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Ghosts stay fully dark at rest — edge lighting with no surface under
         it is just a line floating in space. Both the specular and the rail
         arrive with the material, on hover. -->
    <Style Selector="Button.ghost /template/ Border#EdgeLight">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.ghost /template/ Border#Specular">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ Border#EdgeLight">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ Border#Specular">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#5920304F" />
      <Setter Property="BorderBrush" Value="#26FFFFFF" />
      <Setter Property="TextElement.Foreground" Value="#E8F1FF" />
    </Style>
    <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#800E1728" />
      <Setter Property="BorderBrush" Value="#598FD6FF" />
    </Style>

    <!-- Approve / deny: tinted glass — the color is the material, not a
         paint bucket (visionOS-style translucent tints) -->
    <Style Selector="Button.approve">
      <Setter Property="Foreground" Value="#8CFFCF" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="#2634F5A4" />
      <Setter Property="BorderBrush" Value="#6634F5A4" />
    </Style>
    <Style Selector="Button.approve:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#4D34F5A4" />
      <Setter Property="BorderBrush" Value="#CC34F5A4" />
    </Style>
    <Style Selector="Button.approve:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1A1F8C60" />
      <Setter Property="BorderBrush" Value="#B334F5A4" />
    </Style>
    <Style Selector="Button.deny">
      <Setter Property="Foreground" Value="#FFB4C0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="#26FF5A78" />
      <Setter Property="BorderBrush" Value="#59FF5A78" />
    </Style>
    <Style Selector="Button.deny:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#4DFF5A78" />
      <Setter Property="BorderBrush" Value="#CCFF5A78" />
    </Style>
    <Style Selector="Button.deny:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1A8C2F42" />
      <Setter Property="BorderBrush" Value="#B3FF5A78" />
    </Style>

    <!-- ==== One state model for every button variant ====
         Declared after the variants so it wins, and expressed once rather
         than per-variant, which is how approve and deny drifted into getting
         *brighter* the harder you pressed them.

         rest     surface lit from above (specular on), rail idling
         hover    fill lifts, border brightens, rail ignites
         pressed  fill DARKENS below rest, an inset shadow puts the face below
                  the rim, the specular dies because the top bevel has tilted
                  out of the light, and the whole control compresses
         disabled a flat neutral surface, not a faded coloured one -->

    <!-- The press: recessed, not merely a different colour. -->
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="inset 0 2 6 0 #8C000000" />
    </Style>
    <Style Selector="Button:pressed /template/ Border#Specular">
      <Setter Property="Opacity" Value="0.08" />
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>
    <Style Selector="Button:pointerover /template/ Border#Specular">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Disabled: a dead surface. Fading a coloured button leaves it looking
         like a working button behind fog — the colour still reads as "primary"
         or "destructive" when neither is true any more. -->
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Foreground" Value="#5A7099" />
      <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#420E1728" />
      <Setter Property="BorderBrush" Value="#14FFFFFF" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Button:disabled /template/ Border#EdgeLight">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button:disabled /template/ Border#Specular">
      <Setter Property="Opacity" Value="0.12" />
    </Style>

    <!-- Accent pressed: the same hue driven down into shadow, so it still
         reads as the primary action while clearly being held down. -->
    <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#0E7E9B" Offset="0" />
            <GradientStop Color="#0A6F94" Offset="0.45" />
            <GradientStop Color="#1B4694" Offset="1" />
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="BorderBrush" Value="#40FFFFFF" />
    </Style>
    <Style Selector="Button.accent:pressed">
      <Setter Property="Foreground" Value="#CFEAFF" />
    </Style>

    <!-- Quiet variants had no press state at all beyond the scale: on a still
         frame, and on a slow display, the click simply did not land. -->
    <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#8C05080F" />
      <Setter Property="BorderBrush" Value="#8C7DD3FC" />
    </Style>
    <Style Selector="Button.tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#8C05080F" />
      <Setter Property="BorderBrush" Value="#8C7DD3FC" />
    </Style>

    <!-- Inputs: same glass material — hairline at rest, cyan when focused -->
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#A00C1424" />
      <Setter Property="Foreground" Value="#E4EEFF" />
      <Setter Property="BorderBrush" Value="#1FFFFFFF" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#A00C1424" />
      <Setter Property="BorderBrush" Value="#40FFFFFF" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#A00C1424" />
      <Setter Property="BorderBrush" Value="#CC00D4FF" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="#A00C1424" />
      <Setter Property="Foreground" Value="#E4EEFF" />
      <Setter Property="BorderBrush" Value="#1FFFFFFF" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>

    <!-- Lists sit flush inside cards; selection follows the neon accent
         instead of the stock Fluent blue. -->
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#3312304F" />
      <Setter Property="BorderBrush" Value="#8C00D4FF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#4416385C" />
      <Setter Property="BorderBrush" Value="#CC00D4FF" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#4416385C" />
    </Style>

    <!-- Tiny filter chips (event-stream toggles): pill glass -->
    <Style Selector="ToggleButton.chip">
      <Setter Property="Background" Value="#80141F36" />
      <Setter Property="Foreground" Value="#5A7099" />
      <Setter Property="BorderBrush" Value="#1FFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,2" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.chip:pressed">
      <Setter Property="RenderTransform" Value="scale(0.94)" />
    </Style>
    <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#33194B66" />
      <Setter Property="Foreground" Value="#7DD3FC" />
      <Setter Property="BorderBrush" Value="#9900D4FF" />
    </Style>
    <Style Selector="ToggleButton.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="#9900D4FF" />
    </Style>

    <!-- Approval surfaces drop in instead of appearing (main banner + overlay) -->
    <Style Selector="Border.approvalBanner.show">
      <Style.Animations>
        <Animation Duration="0:0:0.22" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="-16" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Live status dots breathe while their subsystem wants attention -->
    <Style Selector="TextBlock.pulse">
      <Style.Animations>
        <Animation Duration="0:0:1.4" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Opacity" Value="0.35" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Ellipse.pulse">
      <Style.Animations>
        <Animation Duration="0:0:1.4" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Opacity" Value="0.35" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Dim helper text for empty panels -->
    <Style Selector="TextBlock.placeholder">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#5A7099" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- Tooltips match the glass cards instead of the stock theme -->
    <Style Selector="ToolTip">
      <Setter Property="Background" Value="#F0101A2E" />
      <Setter Property="Foreground" Value="#CFE1FF" />
      <Setter Property="BorderBrush" Value="#663D6FA5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontSize" Value="12" />
    </Style>

  </Application.Styles>
</Application>
