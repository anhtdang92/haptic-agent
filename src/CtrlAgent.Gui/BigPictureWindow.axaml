<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gui="using:CtrlAgent.Gui"
        x:Class="CtrlAgent.Gui.BigPictureWindow"
        x:DataType="gui:BigPictureViewModel"
        Title="CtrlAgent Big Picture"
        Icon="avares://CtrlAgent.Gui/Assets/icon.png"
        SystemDecorations="None"
        WindowState="FullScreen"
        Background="#05070D">

  <Window.Styles>
    <!-- Rail tiles: dim glass at rest, neon ring + lift when focused -->
    <Style Selector="Border.tile">
      <Setter Property="Width" Value="164" />
      <Setter Property="Height" Value="128" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="#CC101A2E" />
      <Setter Property="BorderBrush" Value="#3D2E4A78" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.tile.focused">
      <Setter Property="BorderBrush" Value="#00D4FF" />
      <Setter Property="Background" Value="#E0122544" />
      <Setter Property="BoxShadow" Value="0 0 28 0 #6600D4FF" />
      <Setter Property="RenderTransform" Value="scale(1.08)" />
    </Style>

    <!-- Bottom-legend button glyphs -->
    <Style Selector="Border.glyph">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="#0B1322" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </Window.Styles>

  <Panel>
    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" Margin="48,28,48,24">

      <!-- Top status strip -->
      <DockPanel Grid.Row="0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                     Fill="{Binding Main.ControllerDotBrush}"
                     Classes.pulse="{Binding Main.IsControllerSearching}" />
            <TextBlock Text="{Binding Main.ControllerStatus}" FontSize="15" Foreground="#B9CCEF" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                     Fill="{Binding Main.AgentDotBrush}"
                     Classes.pulse="{Binding Main.IsAgentActive}" />
            <TextBlock Text="{Binding Main.AgentStatus}" FontSize="15" Foreground="#EAF3FF" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Main.AgentState}" FontSize="15" Foreground="#7DD3FC" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding Main.ProfileName}" FontSize="15" Foreground="#5A7099" VerticalAlignment="Center" />
        </StackPanel>
        <Image Source="avares://CtrlAgent.Gui/Assets/logo.png"
               Height="44"
               HorizontalAlignment="Left"
               RenderOptions.BitmapInterpolationMode="HighQuality" />
      </DockPanel>

      <!-- Center stage: CTRL·BOT | agent feed -->
      <Grid Grid.Row="1" ColumnDefinitions="2*,3*" Margin="0,28">

        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="18"
                    DataContext="{Binding Main.Buddy}" x:DataType="gui:AgentBuddyViewModel">
          <Viewbox Height="300" Stretch="Uniform">
            <Canvas Width="86" Height="100">
              <Border Canvas.Left="41" Canvas.Top="8" Width="4" Height="14" Background="#2E4A78" />
              <Ellipse Canvas.Left="38" Canvas.Top="0" Width="10" Height="10" Fill="{Binding AccentBrush}" />
              <Border Canvas.Left="8" Canvas.Top="22" Width="70" Height="58"
                      CornerRadius="14" Background="#0B1322"
                      BorderBrush="{Binding AccentBrush}" BorderThickness="2" />
              <Border Canvas.Left="15" Canvas.Top="30" Width="56" Height="36" CornerRadius="8" Background="#060B14" />
              <Canvas IsVisible="{Binding IsIdle}">
                <Border Canvas.Left="24" Canvas.Top="45" Width="13" Height="5" CornerRadius="2" Background="#2E6E8E" />
                <Border Canvas.Left="49" Canvas.Top="45" Width="13" Height="5" CornerRadius="2" Background="#2E6E8E" />
              </Canvas>
              <Canvas IsVisible="{Binding IsWorking}">
                <Canvas.Styles>
                  <Style Selector="Ellipse">
                    <Style.Animations>
                      <Animation Duration="0:0:1.1" IterationCount="Infinite">
                        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.4" /></KeyFrame>
                        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                      </Animation>
                    </Style.Animations>
                  </Style>
                </Canvas.Styles>
                <Ellipse Canvas.Left="24" Canvas.Top="40" Width="13" Height="13" Fill="#00D4FF" />
                <Ellipse Canvas.Left="49" Canvas.Top="40" Width="13" Height="13" Fill="#00D4FF" />
              </Canvas>
              <Canvas IsVisible="{Binding IsAlert}">
                <Ellipse Canvas.Left="23" Canvas.Top="38" Width="15" Height="15" Fill="#FFB020" />
                <Ellipse Canvas.Left="48" Canvas.Top="38" Width="15" Height="15" Fill="#FFB020" />
              </Canvas>
              <Canvas IsVisible="{Binding IsHappy}">
                <Path Canvas.Left="24" Canvas.Top="42" Data="M 0,6 Q 6,-3 13,6" Stroke="#34F5A4" StrokeThickness="3" />
                <Path Canvas.Left="49" Canvas.Top="42" Data="M 0,6 Q 6,-3 13,6" Stroke="#34F5A4" StrokeThickness="3" />
              </Canvas>
              <Canvas IsVisible="{Binding IsError}">
                <Path Canvas.Left="24" Canvas.Top="40" Data="M 0,0 L 12,12 M 12,0 L 0,12" Stroke="#FF5A78" StrokeThickness="3" />
                <Path Canvas.Left="49" Canvas.Top="40" Data="M 0,0 L 12,12 M 12,0 L 0,12" Stroke="#FF5A78" StrokeThickness="3" />
              </Canvas>
              <Border Canvas.Left="36" Canvas.Top="58" Width="14" Height="3" CornerRadius="1.5" Background="#1C3050" />
              <Border Canvas.Left="24" Canvas.Top="84" Width="38" Height="12" CornerRadius="6"
                      Background="#0B1322" BorderBrush="#2E4A78" BorderThickness="1.5" />
            </Canvas>
          </Viewbox>
          <Border Background="#C0122038" BorderBrush="#552E4A78" BorderThickness="1"
                  CornerRadius="14" Padding="20,12" MaxWidth="420">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="17" Foreground="#CFE1FF" />
          </Border>
        </StackPanel>

        <!-- Agent response feed -->
        <Border Grid.Column="1" Classes="card" Padding="24" Margin="24,0,0,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="AGENT FEED" Classes="label" FontSize="13" Margin="0,0,0,14" />
            <Border DockPanel.Dock="Bottom"
                    Background="#33122544"
                    BorderBrush="#5500D4FF"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,12"
                    Margin="0,14,0,0">
              <TextBlock Text="{Binding LatestResponse}"
                         TextWrapping="Wrap"
                         FontSize="19"
                         Foreground="#EAF3FF"
                         MaxLines="5"
                         TextTrimming="CharacterEllipsis" />
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Responses}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}"
                               TextWrapping="Wrap"
                               FontSize="14"
                               Foreground="#8FA8CF"
                               Margin="0,3" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>

      <!-- Pending approval context above the rail -->
      <Border Grid.Row="2"
              Classes="alert"
              Padding="18,10"
              Margin="0,0,0,16"
              HorizontalAlignment="Center"
              IsVisible="{Binding Main.HasPendingApproval}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="APPROVAL REQUIRED" Classes="label" FontSize="12" Foreground="#FFD9A0" Opacity="1" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Main.PendingApprovalMessage}"
                     FontSize="15" Foreground="#FFEFD6" TextWrapping="Wrap" MaxWidth="720" VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- Action rail -->
      <ItemsControl Grid.Row="3" ItemsSource="{Binding Tiles}" HorizontalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="gui:BigPictureTile">
            <Border Classes="tile" Classes.focused="{Binding IsFocused}">
              <StackPanel VerticalAlignment="Center" Spacing="10">
                <TextBlock Text="{Binding Glyph}"
                           FontSize="36"
                           HorizontalAlignment="Center"
                           Foreground="{Binding AccentBrush}" />
                <TextBlock Text="{Binding Label}"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="#DDE9FF" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Button legend -->
      <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="26" HorizontalAlignment="Center" Margin="0,26,0,0">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Border Classes="glyph" BorderBrush="#6EBE45"><TextBlock Text="A" FontSize="14" FontWeight="Bold" Foreground="#6EBE45" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          <TextBlock Text="Select" FontSize="14" Foreground="#B9CCEF" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Border Classes="glyph" BorderBrush="#E85555"><TextBlock Text="B" FontSize="14" FontWeight="Bold" Foreground="#E85555" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          <TextBlock Text="Back / Exit" FontSize="14" Foreground="#B9CCEF" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Border Classes="glyph" BorderBrush="#4C8DF5"><TextBlock Text="X" FontSize="14" FontWeight="Bold" Foreground="#4C8DF5" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          <TextBlock Text="Shortcuts" FontSize="14" Foreground="#B9CCEF" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Border Classes="glyph" BorderBrush="#E8C531"><TextBlock Text="Y" FontSize="14" FontWeight="Bold" Foreground="#E8C531" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          <TextBlock Text="Voice prompt" FontSize="14" Foreground="#B9CCEF" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="D-pad / stick — Navigate" FontSize="14" Foreground="#5A7099" VerticalAlignment="Center" />
        <TextBlock Text="Paddles &amp; chords stay live for approvals" FontSize="14" Foreground="#5A7099" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- Shortcuts screen -->
    <Border Background="#F2060B14" IsVisible="{Binding IsShortcutsVisible}">
      <DockPanel Margin="72,48">
        <TextBlock DockPanel.Dock="Top"
                   Text="CONTROLLER SHORTCUTS"
                   Classes="label"
                   FontSize="18"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10" />
        <TextBlock DockPanel.Dock="Top"
                   Text="Everything the active profile binds. Approval-tagged inputs only fire while the agent is asking for permission. Press B to go back."
                   FontSize="15"
                   Foreground="#8FA8CF"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,26" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Main.Bindings}" HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="14" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="gui:BindingRow">
                <Border Background="#CC101A2E" BorderBrush="#3D2E4A78" BorderThickness="1"
                        CornerRadius="12" Padding="18,14" Width="330">
                  <DockPanel>
                    <Border DockPanel.Dock="Left"
                            Background="#141F36" BorderBrush="#552E4A78" BorderThickness="1"
                            CornerRadius="7" Padding="12,5" MinWidth="112" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Chord}"
                                 FontFamily="Cascadia Mono,Consolas,monospace"
                                 FontSize="16" Foreground="#7DD3FC" HorizontalAlignment="Center" />
                    </Border>
                    <Border DockPanel.Dock="Right"
                            Background="#33FFB020" CornerRadius="6" Padding="8,3"
                            VerticalAlignment="Center" IsVisible="{Binding IsApproval}">
                      <TextBlock Text="approval" FontSize="11" Foreground="#FFD9A0" />
                    </Border>
                    <TextBlock Text="{Binding Action}" FontSize="16" Foreground="#DDE9FF"
                               Margin="14,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Voice prompt overlay -->
    <Border Background="#F2060B14" IsVisible="{Binding IsVoiceVisible}">
      <Border Classes="card" MaxWidth="760" Padding="42,36"
              VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="20" HorizontalAlignment="Center">
          <TextBlock Text="🎤"
                     FontSize="56"
                     HorizontalAlignment="Center"
                     Classes.pulse="{Binding IsListening}" />
          <TextBlock Text="{Binding VoiceStatus}"
                     FontSize="17"
                     Foreground="#9FB7DF"
                     TextWrapping="Wrap"
                     TextAlignment="Center" />
          <Border Background="#33122544" BorderBrush="#5500D4FF" BorderThickness="1"
                  CornerRadius="10" Padding="20,14" MinWidth="480" MinHeight="72"
                  IsVisible="{Binding Transcript, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Transcript}"
                       FontSize="21"
                       Foreground="#EAF3FF"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
          </Border>
        </StackPanel>
      </Border>
    </Border>
  </Panel>
</Window>
