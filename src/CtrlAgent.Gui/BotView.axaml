<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gui="using:CtrlAgent.Gui"
             x:Class="CtrlAgent.Gui.BotView"
             x:DataType="gui:AgentBuddyViewModel"
             ToolTip.Tip="{Binding StatsSummary}">

  <!-- CTRL·BOT, the tamagotchi companion. One shared drawing used by the
       main window and Mainframe; consumers wrap it in a Viewbox to scale.
       Click/tap pokes the bot. Whole-body mood animations live here:
       idle breathes, happy hops and waves, alert bounces urgently,
       error trembles. -->
  <UserControl.Styles>
    <!-- Gentle idle breathing whenever nothing dramatic is happening: it
         rises as it "inhales" and widens a touch as it settles. -->
    <Style Selector="Canvas.botRig:not(.moodHappy):not(.moodAlert):not(.moodError)">
      <Style.Animations>
        <Animation Duration="0:0:5" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="TranslateTransform.Y" Value="0" />
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="TranslateTransform.Y" Value="-2.5" />
            <Setter Property="ScaleTransform.ScaleX" Value="0.99" />
            <Setter Property="ScaleTransform.ScaleY" Value="1.015" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="TranslateTransform.Y" Value="0" />
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Happy: two big celebratory hops that settle into a proud sway, with
         squash on launch and landing (the body carries scale + translate on
         one TransformGroup so both animate together). Runs once — a
         celebration that loops forever stops reading as a celebration. -->
    <Style Selector="Canvas.botRig.moodHappy">
      <Style.Animations>
        <Animation Duration="0:0:2.6" IterationCount="1" FillMode="Forward">
          <!-- anticipation: crouch -->
          <KeyFrame Cue="0%">
            <Setter Property="TranslateTransform.Y" Value="0" />
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="6%">
            <Setter Property="TranslateTransform.Y" Value="2" />
            <Setter Property="ScaleTransform.ScaleX" Value="1.06" />
            <Setter Property="ScaleTransform.ScaleY" Value="0.92" />
          </KeyFrame>
          <!-- hop 1: stretch up, apex, squash on landing -->
          <KeyFrame Cue="14%">
            <Setter Property="TranslateTransform.Y" Value="-11" />
            <Setter Property="ScaleTransform.ScaleX" Value="0.94" />
            <Setter Property="ScaleTransform.ScaleY" Value="1.08" />
          </KeyFrame>
          <KeyFrame Cue="22%">
            <Setter Property="TranslateTransform.Y" Value="-13" />
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="31%">
            <Setter Property="TranslateTransform.Y" Value="1" />
            <Setter Property="ScaleTransform.ScaleX" Value="1.08" />
            <Setter Property="ScaleTransform.ScaleY" Value="0.90" />
          </KeyFrame>
          <!-- hop 2: smaller -->
          <KeyFrame Cue="40%">
            <Setter Property="TranslateTransform.Y" Value="-7" />
            <Setter Property="ScaleTransform.ScaleX" Value="0.96" />
            <Setter Property="ScaleTransform.ScaleY" Value="1.05" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="TranslateTransform.Y" Value="1" />
            <Setter Property="ScaleTransform.ScaleX" Value="1.05" />
            <Setter Property="ScaleTransform.ScaleY" Value="0.94" />
          </KeyFrame>
          <!-- settle into a proud sway -->
          <KeyFrame Cue="62%">
            <Setter Property="TranslateTransform.Y" Value="-2" />
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="80%">
            <Setter Property="TranslateTransform.Y" Value="0" />
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="TranslateTransform.Y" Value="-1" />
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- Shadow reacts to the hop: smaller and fainter the higher it goes -->
    <Style Selector="Canvas.botRig.moodHappy > Ellipse.shadow">
      <Style.Animations>
        <Animation Duration="0:0:2.6" IterationCount="1" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="22%">
            <Setter Property="Opacity" Value="0.35" />
            <Setter Property="ScaleTransform.ScaleX" Value="0.66" />
          </KeyFrame>
          <KeyFrame Cue="31%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="ScaleTransform.ScaleX" Value="1.1" />
          </KeyFrame>
          <KeyFrame Cue="40%">
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="ScaleTransform.ScaleX" Value="0.8" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="ScaleTransform.ScaleX" Value="1.05" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- …with both arms waving, easing off as the celebration settles -->
    <Style Selector="Canvas.botRig.moodHappy > Border.armL">
      <Style.Animations>
        <Animation Duration="0:0:0.42" IterationCount="6" PlaybackDirection="Alternate" FillMode="Forward">
          <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="16" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="54" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Canvas.botRig.moodHappy > Border.armR">
      <Style.Animations>
        <Animation Duration="0:0:0.42" IterationCount="6" PlaybackDirection="Alternate" FillMode="Forward">
          <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="-16" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="-54" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Alert: quick urgent bounces with a little squash on each landing -->
    <Style Selector="Canvas.botRig.moodAlert">
      <Style.Animations>
        <Animation Duration="0:0:0.55" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="TranslateTransform.Y" Value="0" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="30%">
            <Setter Property="TranslateTransform.Y" Value="-6" />
            <Setter Property="ScaleTransform.ScaleY" Value="1.04" />
          </KeyFrame>
          <KeyFrame Cue="58%">
            <Setter Property="TranslateTransform.Y" Value="0" />
            <Setter Property="ScaleTransform.ScaleY" Value="0.95" />
          </KeyFrame>
          <KeyFrame Cue="75%">
            <Setter Property="TranslateTransform.Y" Value="0" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="TranslateTransform.Y" Value="0" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Canvas.botRig.moodAlert > Ellipse.shadow">
      <Style.Animations>
        <Animation Duration="0:0:0.55" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="30%"><Setter Property="Opacity" Value="0.6" /></KeyFrame>
          <KeyFrame Cue="58%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Error: a worried tremble -->
    <Style Selector="Canvas.botRig.moodError">
      <Style.Animations>
        <Animation Duration="0:0:0.5" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="0" /></KeyFrame>
          <KeyFrame Cue="20%"><Setter Property="TranslateTransform.X" Value="-3" /></KeyFrame>
          <KeyFrame Cue="40%"><Setter Property="TranslateTransform.X" Value="3" /></KeyFrame>
          <KeyFrame Cue="60%"><Setter Property="TranslateTransform.X" Value="-2" /></KeyFrame>
          <KeyFrame Cue="80%"><Setter Property="TranslateTransform.X" Value="2" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="0" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="4" HorizontalAlignment="Center">
    <!-- Squash-and-stretch pivots at the feet, so scaling reads as weight
         on the ground rather than a floating resize. -->
    <Canvas Width="92" Height="122" Background="Transparent"
            Classes="botRig"
            Classes.moodHappy="{Binding IsHappy}"
            Classes.moodAlert="{Binding IsAlert}"
            Classes.moodError="{Binding IsError}"
            RenderTransformOrigin="50%,93%"
            Cursor="Hand" PointerPressed="OnPoke">
      <Canvas.RenderTransform>
        <TransformGroup>
          <ScaleTransform ScaleX="1" ScaleY="1" />
          <TranslateTransform X="0" Y="0" />
        </TransformGroup>
      </Canvas.RenderTransform>

      <!-- Ground shadow: shrinks and fades as the bot leaves the ground -->
      <Ellipse Classes="shadow" Canvas.Left="24" Canvas.Top="113" Width="44" Height="7" Fill="#33000000"
               RenderTransformOrigin="50%,50%">
        <Ellipse.RenderTransform>
          <ScaleTransform ScaleX="1" ScaleY="1" />
        </Ellipse.RenderTransform>
      </Ellipse>

      <!-- Antenna: stem + halo + mood-colored tip. The halo breathes so the
           bot always looks powered on, even when it is doing nothing. -->
      <Canvas.Styles>
        <Style Selector="Ellipse.antennaHalo">
          <Style.Animations>
            <Animation Duration="0:0:2.6" IterationCount="Infinite" Easing="SineEaseInOut">
              <KeyFrame Cue="0%">
                <Setter Property="Opacity" Value="0.16" />
                <Setter Property="ScaleTransform.ScaleX" Value="0.85" />
                <Setter Property="ScaleTransform.ScaleY" Value="0.85" />
              </KeyFrame>
              <KeyFrame Cue="50%">
                <Setter Property="Opacity" Value="0.42" />
                <Setter Property="ScaleTransform.ScaleX" Value="1.15" />
                <Setter Property="ScaleTransform.ScaleY" Value="1.15" />
              </KeyFrame>
              <KeyFrame Cue="100%">
                <Setter Property="Opacity" Value="0.16" />
                <Setter Property="ScaleTransform.ScaleX" Value="0.85" />
                <Setter Property="ScaleTransform.ScaleY" Value="0.85" />
              </KeyFrame>
            </Animation>
          </Style.Animations>
        </Style>
      </Canvas.Styles>
      <Border Canvas.Left="44" Canvas.Top="10" Width="4" Height="13" CornerRadius="2">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#4A6FA5" Offset="0" />
            <GradientStop Color="#22375C" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Ellipse Classes="antennaHalo" Canvas.Left="37" Canvas.Top="-3" Width="18" Height="18"
               Fill="{Binding AccentBrush}" RenderTransformOrigin="50%,50%">
        <Ellipse.RenderTransform>
          <ScaleTransform ScaleX="1" ScaleY="1" />
        </Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse Canvas.Left="41" Canvas.Top="1" Width="10" Height="10" Fill="{Binding AccentBrush}" />
      <!-- Specular pip: turns the flat tip into a little glass bead -->
      <Ellipse Canvas.Left="42.8" Canvas.Top="2.6" Width="2.6" Height="2.6" Fill="#B3FFFFFF" IsHitTestVisible="False" />

      <!-- Side ears -->
      <Border Canvas.Left="4" Canvas.Top="41" Width="7" Height="20" CornerRadius="3,0,0,3"
              BorderBrush="#2E4A78" BorderThickness="1">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#2A4166" Offset="0" />
            <GradientStop Color="#0E1728" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Border Canvas.Left="81" Canvas.Top="41" Width="7" Height="20" CornerRadius="0,3,3,0"
              BorderBrush="#2E4A78" BorderThickness="1">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#2A4166" Offset="0" />
            <GradientStop Color="#0E1728" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <!-- Stubby arms (waved via RotateTransform when happy) -->
      <Border Classes="armL" Canvas.Left="2" Canvas.Top="66" Width="9" Height="19" CornerRadius="4.5"
              BorderBrush="#2E4A78" BorderThickness="1.5"
              RenderTransformOrigin="50%,10%">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#2A4166" Offset="0" />
            <GradientStop Color="#101A2C" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <Border.RenderTransform>
          <RotateTransform Angle="16" />
        </Border.RenderTransform>
      </Border>
      <Border Classes="armR" Canvas.Left="81" Canvas.Top="66" Width="9" Height="19" CornerRadius="4.5"
              BorderBrush="#2E4A78" BorderThickness="1.5"
              RenderTransformOrigin="50%,10%">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#2A4166" Offset="0" />
            <GradientStop Color="#101A2C" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <Border.RenderTransform>
          <RotateTransform Angle="-16" />
        </Border.RenderTransform>
      </Border>

      <!-- Head: a moulded shell, lit from up-left. A radial fill curves the
           surface where a vertical gradient only ever made it look papery. -->
      <Border Canvas.Left="10" Canvas.Top="22" Width="72" Height="60"
              CornerRadius="20"
              BorderBrush="{Binding AccentBrush}"
              BorderThickness="2"
              BoxShadow="0 4 18 0 #3300D4FF">
        <Border.Background>
          <RadialGradientBrush Center="32%,22%" GradientOrigin="32%,22%" RadiusX="95%" RadiusY="95%">
            <GradientStop Color="#263A5F" Offset="0" />
            <GradientStop Color="#16243D" Offset="0.55" />
            <GradientStop Color="#080F1C" Offset="1" />
          </RadialGradientBrush>
        </Border.Background>
      </Border>
      <!-- Toy gloss: the fat highlight across the top of moulded plastic.
           This one shape is most of what makes it read as an object you
           could pick up. -->
      <Border Canvas.Left="16" Canvas.Top="26" Width="60" Height="24"
              CornerRadius="16,16,20,20" IsHitTestVisible="False" Opacity="0.5">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#4DFFFFFF" Offset="0" />
            <GradientStop Color="#14FFFFFF" Offset="0.55" />
            <GradientStop Color="#00FFFFFF" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <!-- Face screen with bezel -->
      <Border Canvas.Left="18" Canvas.Top="31" Width="56" Height="39"
              CornerRadius="10"
              BorderBrush="#1C3050"
              BorderThickness="1">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#04070E" Offset="0" />
            <GradientStop Color="#081426" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <!-- Blush cheeks: always faintly there, part of the charm -->
      <Ellipse Canvas.Left="20" Canvas.Top="58" Width="12" Height="7" Fill="#FF9EC4" Opacity="0.32" />
      <Ellipse Canvas.Left="60" Canvas.Top="58" Width="12" Height="7" Fill="#FF9EC4" Opacity="0.32" />

      <!-- Idle: big glossy eyes with glints; blink every few seconds -->
      <Canvas IsVisible="{Binding IsIdle}">
        <Canvas.Styles>
          <Style Selector="Border.eye">
            <Style.Animations>
              <Animation Duration="0:0:4.6" IterationCount="Infinite">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                <KeyFrame Cue="91%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                <KeyFrame Cue="94%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                <KeyFrame Cue="97%"><Setter Property="Opacity" Value="1" /></KeyFrame>
              </Animation>
            </Style.Animations>
          </Style>
        </Canvas.Styles>
        <Border Classes="eye" Canvas.Left="27" Canvas.Top="40" Width="14" Height="12" CornerRadius="6" Background="#6FC7EE">
          <Ellipse Width="4" Height="4" Fill="#EFFBFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2.5,2,0,0" />
        </Border>
        <Border Classes="eye" Canvas.Left="51" Canvas.Top="40" Width="14" Height="12" CornerRadius="6" Background="#6FC7EE">
          <Ellipse Width="4" Height="4" Fill="#EFFBFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2.5,2,0,0" />
        </Border>
      </Canvas>

      <!-- Working: throbbing focus eyes -->
      <Canvas IsVisible="{Binding IsWorking}">
        <Canvas.Styles>
          <Style Selector="Ellipse.beam">
            <Style.Animations>
              <Animation Duration="0:0:1.1" IterationCount="Infinite">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.4" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
              </Animation>
            </Style.Animations>
          </Style>
        </Canvas.Styles>
        <Ellipse Classes="beam" Canvas.Left="24" Canvas.Top="37" Width="19" Height="19" Fill="#3300D4FF" />
        <Ellipse Classes="beam" Canvas.Left="49" Canvas.Top="37" Width="19" Height="19" Fill="#3300D4FF" />
        <Ellipse Classes="beam" Canvas.Left="27" Canvas.Top="40" Width="13" Height="13" Fill="#00D4FF" />
        <Ellipse Classes="beam" Canvas.Left="52" Canvas.Top="40" Width="13" Height="13" Fill="#00D4FF" />
        <Ellipse Canvas.Left="30" Canvas.Top="42" Width="4" Height="4" Fill="#EFFBFF" />
        <Ellipse Canvas.Left="55" Canvas.Top="42" Width="4" Height="4" Fill="#EFFBFF" />
      </Canvas>

      <!-- Alert: wide eyes + "!" — something needs an answer -->
      <Canvas IsVisible="{Binding IsAlert}">
        <Canvas.Styles>
          <Style Selector="Ellipse.ping">
            <Style.Animations>
              <Animation Duration="0:0:0.7" IterationCount="Infinite">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.5" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
              </Animation>
            </Style.Animations>
          </Style>
        </Canvas.Styles>
        <Ellipse Classes="ping" Canvas.Left="26" Canvas.Top="38" Width="15" Height="15" Fill="#FFB020" />
        <Ellipse Classes="ping" Canvas.Left="51" Canvas.Top="38" Width="15" Height="15" Fill="#FFB020" />
        <Ellipse Canvas.Left="29" Canvas.Top="40" Width="4" Height="4" Fill="#FFF4DC" />
        <Ellipse Canvas.Left="54" Canvas.Top="40" Width="4" Height="4" Fill="#FFF4DC" />
        <TextBlock Canvas.Left="68" Canvas.Top="24" Text="!" FontSize="15" FontWeight="Bold" Foreground="#FFB020" />
      </Canvas>

      <!-- Happy: closed smiling eyes -->
      <Canvas IsVisible="{Binding IsHappy}">
        <Path Canvas.Left="27" Canvas.Top="42" Data="M 0,6 Q 6,-3 13,6" Stroke="#34F5A4" StrokeThickness="3" />
        <Path Canvas.Left="52" Canvas.Top="42" Data="M 0,6 Q 6,-3 13,6" Stroke="#34F5A4" StrokeThickness="3" />
      </Canvas>

      <!-- Error: dizzy eyes + a sweat drop -->
      <Canvas IsVisible="{Binding IsError}">
        <Path Canvas.Left="27" Canvas.Top="40" Data="M 0,0 L 12,12 M 12,0 L 0,12" Stroke="#FF5A78" StrokeThickness="3" />
        <Path Canvas.Left="52" Canvas.Top="40" Data="M 0,0 L 12,12 M 12,0 L 0,12" Stroke="#FF5A78" StrokeThickness="3" />
        <Ellipse Canvas.Left="72" Canvas.Top="32" Width="5" Height="8" Fill="#7DD3FC" Opacity="0.75" />
      </Canvas>

      <!-- Little smile, tinted by mood -->
      <Path Canvas.Left="40" Canvas.Top="61" Data="M 0,0 Q 6,5 12,0"
            Stroke="{Binding AccentBrush}" StrokeThickness="2" Opacity="0.75" />

      <!-- Screen glass: one diagonal sheen laid over the whole face, eyes
           included, so the face reads as something behind glass rather than
           printed on. Sits above everything in the head; never hit-tests. -->
      <Border Canvas.Left="18" Canvas.Top="31" Width="56" Height="39"
              CornerRadius="10" IsHitTestVisible="False" Opacity="0.11">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="85%,100%">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#66FFFFFF" Offset="0.26" />
            <GradientStop Color="#00FFFFFF" Offset="0.52" />
            <GradientStop Color="#00FFFFFF" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <!-- Neck -->
      <Border Canvas.Left="40" Canvas.Top="82" Width="12" Height="6" CornerRadius="2" Background="#16233C" />

      <!-- Chassis: a rounded body with a reactor core that beats. The core
           pulses on the mood colour, so a glance at the torso tells you the
           same thing the eyes do. -->
      <Canvas.Styles>
        <Style Selector="Ellipse.core">
          <Style.Animations>
            <Animation Duration="0:0:1.8" IterationCount="Infinite" Easing="SineEaseInOut">
              <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.55" /></KeyFrame>
              <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1" /></KeyFrame>
              <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.55" /></KeyFrame>
            </Animation>
          </Style.Animations>
        </Style>
      </Canvas.Styles>
      <Border Canvas.Left="24" Canvas.Top="87" Width="44" Height="15" CornerRadius="8"
              BorderBrush="#2E4A78" BorderThickness="1.5">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#1B2C49" Offset="0" />
            <GradientStop Color="#080F1C" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <!-- Vents either side of the core -->
      <Border Canvas.Left="29" Canvas.Top="92" Width="8" Height="2" CornerRadius="1" Background="#22375C" />
      <Border Canvas.Left="29" Canvas.Top="96" Width="8" Height="2" CornerRadius="1" Background="#22375C" />
      <Border Canvas.Left="55" Canvas.Top="92" Width="8" Height="2" CornerRadius="1" Background="#22375C" />
      <Border Canvas.Left="55" Canvas.Top="96" Width="8" Height="2" CornerRadius="1" Background="#22375C" />
      <!-- Reactor core -->
      <Ellipse Classes="core" Canvas.Left="40" Canvas.Top="89" Width="12" Height="12"
               Fill="{Binding AccentBrush}" Opacity="0.28" />
      <Ellipse Canvas.Left="43" Canvas.Top="92" Width="6" Height="6" Fill="{Binding AccentBrush}" />
      <Ellipse Canvas.Left="44" Canvas.Top="93" Width="2.5" Height="2.5" Fill="#CCFFFFFF" IsHitTestVisible="False" />
      <!-- Chassis top highlight -->
      <Border Canvas.Left="28" Canvas.Top="88.5" Width="36" Height="4" CornerRadius="2"
              IsHitTestVisible="False" Opacity="0.4">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#59FFFFFF" Offset="0" />
            <GradientStop Color="#00FFFFFF" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <!-- Feet: rounded pads with a top catch-light -->
      <Border Canvas.Left="30" Canvas.Top="102" Width="13" Height="10" CornerRadius="5"
              BorderBrush="#2E4A78" BorderThickness="1">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#22375C" Offset="0" />
            <GradientStop Color="#0B1322" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Border Canvas.Left="49" Canvas.Top="102" Width="13" Height="10" CornerRadius="5"
              BorderBrush="#2E4A78" BorderThickness="1">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#22375C" Offset="0" />
            <GradientStop Color="#0B1322" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
    </Canvas>

    <!-- Name, level, and XP toward the next level -->
    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
      <TextBlock Text="CTRL·BOT" FontSize="8" LetterSpacing="1.5" Foreground="#4A6FA5" VerticalAlignment="Center" />
      <Border Background="#141F36" BorderBrush="#552E4A78" BorderThickness="1" CornerRadius="4" Padding="4,0">
        <TextBlock Text="{Binding LevelText}" FontSize="8" FontWeight="Bold" Foreground="#7DD3FC" />
      </Border>
      <Border Width="58" Height="5" CornerRadius="2.5" Background="#141F36"
              BorderBrush="#552E4A78" BorderThickness="1" VerticalAlignment="Center">
        <Border Width="{Binding XpBarWidth}" Height="3" CornerRadius="1.5" HorizontalAlignment="Left">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
              <GradientStop Color="#00D4FF" Offset="0" />
              <GradientStop Color="#34F5A4" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
