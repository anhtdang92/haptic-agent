<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gui="using:CtrlAgent.Gui"
             x:Class="CtrlAgent.Gui.ControllerMirrorView"
             x:DataType="gui:ControllerVisualViewModel">

  <!-- The live Elite Series 2 mirror: one shared drawing used by the main
       window and Mainframe. Bind DataContext to ControllerVisualViewModel;
       every control lights up as it is used (pressed cyan, approval-eligible
       amber), triggers fill, stick knobs and their gloss track deflection.
       Elite Series 2 layout: asymmetric Xbox sticks, hybrid d-pad disc,
       notched stick rings, guide button, rear paddle blades. -->
  <Viewbox Stretch="Uniform">
              <Canvas Width="420" Height="248">

                <!-- Trigger pull bars -->
                <TextBlock Canvas.Left="84" Canvas.Top="1" Text="LT" FontSize="8" Foreground="#5A7099" />
                <Border Canvas.Left="100" Canvas.Top="0" Width="70" Height="11"
                        CornerRadius="5" Background="#141F36" BorderBrush="#552E4A78" BorderThickness="1">
                  <Border Width="{Binding LeftTriggerWidth}" Height="7" CornerRadius="3"
                          HorizontalAlignment="Left" Margin="1,0,0,0" Background="#00D4FF" />
                </Border>
                <Border Canvas.Left="250" Canvas.Top="0" Width="70" Height="11"
                        CornerRadius="5" Background="#141F36" BorderBrush="#552E4A78" BorderThickness="1">
                  <Border Width="{Binding RightTriggerWidth}" Height="7" CornerRadius="3"
                          HorizontalAlignment="Left" Margin="1,0,0,0" Background="#00D4FF" />
                </Border>
                <TextBlock Canvas.Left="324" Canvas.Top="1" Text="RT" FontSize="8" Foreground="#5A7099" />

                <!-- Bumpers with labels -->
                <Border Canvas.Left="94" Canvas.Top="16" Width="98" Height="15" CornerRadius="8,8,3,3"
                        Background="{Binding LeftShoulderBrush}" RenderTransform="rotate(-3deg)" />
                <Border Canvas.Left="228" Canvas.Top="16" Width="98" Height="15" CornerRadius="8,8,3,3"
                        Background="{Binding RightShoulderBrush}" RenderTransform="rotate(3deg)" />
                <!-- Bumper crowns: a lit top face so they read as rounded bars
                     you could press, not painted rectangles -->
                <Border Canvas.Left="98" Canvas.Top="17" Width="90" Height="5" CornerRadius="3"
                        IsHitTestVisible="False" RenderTransform="rotate(-3deg)" Opacity="0.75">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                      <GradientStop Color="#59FFFFFF" Offset="0" />
                      <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
                <Border Canvas.Left="232" Canvas.Top="17" Width="90" Height="5" CornerRadius="3"
                        IsHitTestVisible="False" RenderTransform="rotate(3deg)" Opacity="0.75">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                      <GradientStop Color="#59FFFFFF" Offset="0" />
                      <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
                <TextBlock Canvas.Left="136" Canvas.Top="18" Text="LB" FontSize="8" Foreground="#8FA9D6" IsHitTestVisible="False" />
                <TextBlock Canvas.Left="272" Canvas.Top="18" Text="RB" FontSize="8" Foreground="#8FA9D6" IsHitTestVisible="False" />

                <!-- Cast shadow grounds the whole controller -->
                <Ellipse Canvas.Left="70" Canvas.Top="176" Width="280" Height="26" Opacity="0.55">
                  <Ellipse.Fill>
                    <RadialGradientBrush>
                      <GradientStop Color="#66000000" Offset="0" />
                      <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>

                <!-- Grips: flared, lit from above like molded plastic -->
                <Ellipse Canvas.Left="38" Canvas.Top="58" Width="96" Height="152"
                         Stroke="#3E5680" StrokeThickness="1.2"
                         RenderTransform="rotate(-18deg)">
                  <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="30%,0%" EndPoint="70%,100%">
                      <GradientStop Color="#33496F" Offset="0" />
                      <GradientStop Color="#1E2C49" Offset="0.45" />
                      <GradientStop Color="#121C31" Offset="1" />
                    </LinearGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>
                <Ellipse Canvas.Left="286" Canvas.Top="58" Width="96" Height="152"
                         Stroke="#3E5680" StrokeThickness="1.2"
                         RenderTransform="rotate(18deg)">
                  <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="70%,0%" EndPoint="30%,100%">
                      <GradientStop Color="#33496F" Offset="0" />
                      <GradientStop Color="#1E2C49" Offset="0.45" />
                      <GradientStop Color="#121C31" Offset="1" />
                    </LinearGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>

                <!-- Grip rim light: the same ellipse again, stroked with a
                     gradient that is bright where the light hits and gone
                     underneath. This edge is what turns a flat silhouette
                     into moulded plastic — outline alone reads as wireframe. -->
                <Ellipse Canvas.Left="38" Canvas.Top="58" Width="96" Height="152"
                         StrokeThickness="2.5" IsHitTestVisible="False"
                         RenderTransform="rotate(-18deg)">
                  <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="20%,0%" EndPoint="60%,75%">
                      <GradientStop Color="#8CBFDDFF" Offset="0" />
                      <GradientStop Color="#2699C8F0" Offset="0.35" />
                      <GradientStop Color="#00FFFFFF" Offset="0.7" />
                    </LinearGradientBrush>
                  </Ellipse.Stroke>
                </Ellipse>
                <Ellipse Canvas.Left="286" Canvas.Top="58" Width="96" Height="152"
                         StrokeThickness="2.5" IsHitTestVisible="False"
                         RenderTransform="rotate(18deg)">
                  <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="80%,0%" EndPoint="40%,75%">
                      <GradientStop Color="#8CBFDDFF" Offset="0" />
                      <GradientStop Color="#2699C8F0" Offset="0.35" />
                      <GradientStop Color="#00FFFFFF" Offset="0.7" />
                    </LinearGradientBrush>
                  </Ellipse.Stroke>
                </Ellipse>

                <!-- Body shell: navy glass with a faint cyan underglow -->
                <Border Canvas.Left="78" Canvas.Top="30" Width="264" Height="120" CornerRadius="46"
                        BorderBrush="#33456B" BorderThickness="1.5"
                        BoxShadow="0 8 26 0 #2200D4FF">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                      <GradientStop Color="#243554" Offset="0" />
                      <GradientStop Color="#16233C" Offset="0.4" />
                      <GradientStop Color="#0C1424" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
                <!-- Top sheen: light catching the shell's curve -->
                <Border Canvas.Left="94" Canvas.Top="34" Width="232" Height="26" CornerRadius="24"
                        IsHitTestVisible="False">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                      <GradientStop Color="#26FFFFFF" Offset="0" />
                      <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>

                <!-- Body rim + underside: a lit top edge and a shadowed belly.
                     Cheap ambient occlusion — the shell now has a near side. -->
                <Border Canvas.Left="78" Canvas.Top="30" Width="264" Height="120" CornerRadius="46"
                        BorderThickness="1.5" IsHitTestVisible="False">
                  <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                      <GradientStop Color="#8CAFD4F5" Offset="0" />
                      <GradientStop Color="#1AFFFFFF" Offset="0.35" />
                      <GradientStop Color="#00FFFFFF" Offset="0.7" />
                    </LinearGradientBrush>
                  </Border.BorderBrush>
                </Border>
                <Border Canvas.Left="92" Canvas.Top="112" Width="236" Height="34" CornerRadius="30"
                        IsHitTestVisible="False" Opacity="0.55">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                      <GradientStop Color="#00000000" Offset="0" />
                      <GradientStop Color="#73000000" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>

                <!-- Machined detail: vent slits, the kind of grille a moulded
                     shell actually carries -->
                <Border Canvas.Left="104" Canvas.Top="60" Width="16" Height="2" CornerRadius="1" Background="#26FFFFFF" IsHitTestVisible="False" />
                <Border Canvas.Left="104" Canvas.Top="66" Width="16" Height="2" CornerRadius="1" Background="#1AFFFFFF" IsHitTestVisible="False" />
                <Border Canvas.Left="300" Canvas.Top="60" Width="16" Height="2" CornerRadius="1" Background="#26FFFFFF" IsHitTestVisible="False" />
                <Border Canvas.Left="300" Canvas.Top="66" Width="16" Height="2" CornerRadius="1" Background="#1AFFFFFF" IsHitTestVisible="False" />

                <!-- Guide button (nexus): domed with a glow -->
                <Ellipse Canvas.Left="188" Canvas.Top="16" Width="44" Height="44" Fill="#3300D4FF" />
                <Ellipse Canvas.Left="194" Canvas.Top="22" Width="32" Height="32" Stroke="{Binding GuideBrush}" StrokeThickness="1.5">
                  <Ellipse.Fill>
                    <RadialGradientBrush Center="35%,30%" GradientOrigin="35%,30%">
                      <GradientStop Color="#1B2740" Offset="0" />
                      <GradientStop Color="#070C16" Offset="1" />
                    </RadialGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>
                <Ellipse Canvas.Left="200" Canvas.Top="28" Width="20" Height="20" Opacity="0.95">
                  <Ellipse.Fill>
                    <RadialGradientBrush Center="35%,30%" GradientOrigin="35%,30%">
                      <GradientStop Color="#FFFFFF" Offset="0" />
                      <GradientStop Color="#9FD8F2" Offset="1" />
                    </RadialGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>

                <!-- Left stick: high-left, Elite notched ring; the knob and
                     its gloss ride one transform so the shine tracks it -->
                <Ellipse Canvas.Left="118" Canvas.Top="60" Width="58" Height="58"
                         Stroke="#3D5578" StrokeThickness="5" StrokeDashArray="1.2,0.6">
                  <Ellipse.Fill>
                    <RadialGradientBrush>
                      <GradientStop Color="#04070D" Offset="0" />
                      <GradientStop Color="#101B30" Offset="1" />
                    </RadialGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>
                <Ellipse Canvas.Left="133" Canvas.Top="79" Width="30" Height="26" Fill="#66000000" />
                <Canvas Canvas.Left="131" Canvas.Top="73" Width="32" Height="32">
                  <Canvas.RenderTransform>
                    <TranslateTransform X="{Binding LeftStickOffsetX}" Y="{Binding LeftStickOffsetY}" />
                  </Canvas.RenderTransform>
                  <Ellipse Width="32" Height="32"
                           Fill="{Binding LeftThumbBrush}" Stroke="#7DD3FC" StrokeThickness="1" />
                  <Ellipse Canvas.Left="5" Canvas.Top="3" Width="18" Height="11" IsHitTestVisible="False">
                    <Ellipse.Fill>
                      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#59FFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                      </LinearGradientBrush>
                    </Ellipse.Fill>
                  </Ellipse>
                  <Ellipse Canvas.Left="6" Canvas.Top="6" Width="20" Height="20"
                           Stroke="#33000000" StrokeThickness="2" IsHitTestVisible="False" />
                </Canvas>

                <!-- View / Menu / profile switch -->
                <Ellipse Canvas.Left="184" Canvas.Top="82" Width="14" Height="14" Fill="{Binding ViewBrush}" />
                <Ellipse Canvas.Left="222" Canvas.Top="82" Width="14" Height="14" Fill="{Binding MenuBrush}" />
                <Ellipse Canvas.Left="205" Canvas.Top="104" Width="10" Height="10" Fill="#1B2740" Stroke="#33456B" StrokeThickness="1" />

                <!-- Face buttons: recessed wells, glossy caps, Xbox letter colors -->
                <Ellipse Canvas.Left="278" Canvas.Top="51" Width="30" Height="30" Fill="#59000000" />
                <Ellipse Canvas.Left="250" Canvas.Top="78" Width="30" Height="30" Fill="#59000000" />
                <Ellipse Canvas.Left="306" Canvas.Top="78" Width="30" Height="30" Fill="#59000000" />
                <Ellipse Canvas.Left="278" Canvas.Top="105" Width="30" Height="30" Fill="#59000000" />
                <Ellipse Canvas.Left="280" Canvas.Top="52" Width="26" Height="26" Fill="{Binding YBrush}" Stroke="#33456B" StrokeThickness="1" />
                <Ellipse Canvas.Left="252" Canvas.Top="79" Width="26" Height="26" Fill="{Binding XBrush}" Stroke="#33456B" StrokeThickness="1" />
                <Ellipse Canvas.Left="308" Canvas.Top="79" Width="26" Height="26" Fill="{Binding BBrush}" Stroke="#33456B" StrokeThickness="1" />
                <Ellipse Canvas.Left="280" Canvas.Top="106" Width="26" Height="26" Fill="{Binding ABrush}" Stroke="#33456B" StrokeThickness="1" />
                <!-- Dome shading: clear at the top-left where the light lands,
                     darkening to the rim. Laid over the bound fills so the
                     caps curve without losing their state colour. -->
                <Canvas.Resources>
                  <RadialGradientBrush x:Key="CapDome" Center="34%,28%" GradientOrigin="34%,28%" RadiusX="78%" RadiusY="78%">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#1A000000" Offset="0.55" />
                    <GradientStop Color="#73000000" Offset="1" />
                  </RadialGradientBrush>
                </Canvas.Resources>
                <Ellipse Canvas.Left="280" Canvas.Top="52" Width="26" Height="26" Fill="{StaticResource CapDome}" IsHitTestVisible="False" />
                <Ellipse Canvas.Left="252" Canvas.Top="79" Width="26" Height="26" Fill="{StaticResource CapDome}" IsHitTestVisible="False" />
                <Ellipse Canvas.Left="308" Canvas.Top="79" Width="26" Height="26" Fill="{StaticResource CapDome}" IsHitTestVisible="False" />
                <Ellipse Canvas.Left="280" Canvas.Top="106" Width="26" Height="26" Fill="{StaticResource CapDome}" IsHitTestVisible="False" />
                <!-- Gloss caps (never intercept the bound fills underneath) -->
                <Ellipse Canvas.Left="284" Canvas.Top="54" Width="18" Height="9" Fill="#40FFFFFF" IsHitTestVisible="False" />
                <Ellipse Canvas.Left="256" Canvas.Top="81" Width="18" Height="9" Fill="#40FFFFFF" IsHitTestVisible="False" />
                <Ellipse Canvas.Left="312" Canvas.Top="81" Width="18" Height="9" Fill="#40FFFFFF" IsHitTestVisible="False" />
                <Ellipse Canvas.Left="284" Canvas.Top="108" Width="18" Height="9" Fill="#40FFFFFF" IsHitTestVisible="False" />
                <TextBlock Canvas.Left="288" Canvas.Top="56" Text="{Binding NorthLabel}" FontSize="12" FontWeight="Bold" Foreground="#E8C531" />
                <TextBlock Canvas.Left="260" Canvas.Top="83" Text="{Binding WestLabel}" FontSize="12" FontWeight="Bold" Foreground="#4C8DF5" />
                <TextBlock Canvas.Left="316" Canvas.Top="83" Text="{Binding EastLabel}" FontSize="12" FontWeight="Bold" Foreground="#E85555" />
                <TextBlock Canvas.Left="288" Canvas.Top="110" Text="{Binding SouthLabel}" FontSize="12" FontWeight="Bold" Foreground="#6EBE45" />

                <!-- Hybrid d-pad: dished disc with a domed pivot -->
                <Ellipse Canvas.Left="136" Canvas.Top="120" Width="54" Height="54" Stroke="#33456B" StrokeThickness="1.5">
                  <Ellipse.Fill>
                    <RadialGradientBrush>
                      <GradientStop Color="#05080F" Offset="0" />
                      <GradientStop Color="#141F36" Offset="1" />
                    </RadialGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>
                <Border Canvas.Left="155" Canvas.Top="126" Width="16" Height="14" CornerRadius="3" Background="{Binding DPadUpBrush}" />
                <Border Canvas.Left="155" Canvas.Top="154" Width="16" Height="14" CornerRadius="3" Background="{Binding DPadDownBrush}" />
                <Border Canvas.Left="141" Canvas.Top="140" Width="14" Height="14" CornerRadius="3" Background="{Binding DPadLeftBrush}" />
                <Border Canvas.Left="171" Canvas.Top="140" Width="14" Height="14" CornerRadius="3" Background="{Binding DPadRightBrush}" />
                <!-- Bevel: a catch-light on the top face of each pad, so the
                     cross sits proud of the dish instead of lying flat in it. -->
                <Border Canvas.Left="156.5" Canvas.Top="127" Width="13" Height="2" CornerRadius="1" Background="#40FFFFFF" IsHitTestVisible="False" />
                <Border Canvas.Left="156.5" Canvas.Top="155" Width="13" Height="2" CornerRadius="1" Background="#26FFFFFF" IsHitTestVisible="False" />
                <Border Canvas.Left="142" Canvas.Top="141" Width="11" Height="2" CornerRadius="1" Background="#33FFFFFF" IsHitTestVisible="False" />
                <Border Canvas.Left="172" Canvas.Top="141" Width="11" Height="2" CornerRadius="1" Background="#33FFFFFF" IsHitTestVisible="False" />
                <Border Canvas.Left="155" Canvas.Top="140" Width="16" Height="14" Background="#131B2C" />
                <Ellipse Canvas.Left="158" Canvas.Top="142" Width="10" Height="10" IsHitTestVisible="False">
                  <Ellipse.Fill>
                    <RadialGradientBrush Center="35%,30%" GradientOrigin="35%,30%">
                      <GradientStop Color="#2E4064" Offset="0" />
                      <GradientStop Color="#10192B" Offset="1" />
                    </RadialGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>

                <!-- Right stick: low-center-right, notched ring -->
                <Ellipse Canvas.Left="226" Canvas.Top="118" Width="58" Height="58"
                         Stroke="#3D5578" StrokeThickness="5" StrokeDashArray="1.2,0.6">
                  <Ellipse.Fill>
                    <RadialGradientBrush>
                      <GradientStop Color="#04070D" Offset="0" />
                      <GradientStop Color="#101B30" Offset="1" />
                    </RadialGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>
                <Ellipse Canvas.Left="241" Canvas.Top="137" Width="30" Height="26" Fill="#66000000" />
                <Canvas Canvas.Left="239" Canvas.Top="131" Width="32" Height="32">
                  <Canvas.RenderTransform>
                    <TranslateTransform X="{Binding RightStickOffsetX}" Y="{Binding RightStickOffsetY}" />
                  </Canvas.RenderTransform>
                  <Ellipse Width="32" Height="32"
                           Fill="{Binding RightThumbBrush}" Stroke="#7DD3FC" StrokeThickness="1" />
                  <Ellipse Canvas.Left="5" Canvas.Top="3" Width="18" Height="11" IsHitTestVisible="False">
                    <Ellipse.Fill>
                      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#59FFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                      </LinearGradientBrush>
                    </Ellipse.Fill>
                  </Ellipse>
                  <Ellipse Canvas.Left="6" Canvas.Top="6" Width="20" Height="20"
                           Stroke="#33000000" StrokeThickness="2" IsHitTestVisible="False" />
                </Canvas>

                <!-- Rear paddles: metal-edged blade pairs as on the real back -->
                <Border Canvas.Left="158" Canvas.Top="196" Width="13" Height="42" CornerRadius="6"
                        Background="{Binding PaddleLeft1Brush}" BorderBrush="#3D5578" BorderThickness="1"
                        BoxShadow="0 3 6 0 #66000000" />
                <Border Canvas.Left="177" Canvas.Top="200" Width="13" Height="32" CornerRadius="6"
                        Background="{Binding PaddleLeft2Brush}" BorderBrush="#3D5578" BorderThickness="1"
                        BoxShadow="0 3 6 0 #66000000" />
                <Border Canvas.Left="230" Canvas.Top="200" Width="13" Height="32" CornerRadius="6"
                        Background="{Binding PaddleRight2Brush}" BorderBrush="#3D5578" BorderThickness="1"
                        BoxShadow="0 3 6 0 #66000000" />
                <Border Canvas.Left="249" Canvas.Top="196" Width="13" Height="42" CornerRadius="6"
                        Background="{Binding PaddleRight1Brush}" BorderBrush="#3D5578" BorderThickness="1"
                        BoxShadow="0 3 6 0 #66000000" />
                <TextBlock Canvas.Left="157" Canvas.Top="238" Text="P1" FontSize="8" Foreground="#5A7099" />
                <TextBlock Canvas.Left="176" Canvas.Top="238" Text="P2" FontSize="8" Foreground="#5A7099" />
                <TextBlock Canvas.Left="229" Canvas.Top="238" Text="P4" FontSize="8" Foreground="#5A7099" />
                <TextBlock Canvas.Left="248" Canvas.Top="238" Text="P3" FontSize="8" Foreground="#5A7099" />
                <TextBlock Canvas.Left="196" Canvas.Top="214" Text="REAR" FontSize="7" LetterSpacing="2" Foreground="#3D5578" />

              </Canvas>
  </Viewbox>
</UserControl>
