<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gui="using:CtrlAgent.Gui"
        x:Class="CtrlAgent.Gui.MainWindow"
        x:DataType="gui:MainViewModel"
        Title="CtrlAgent"
        Width="960"
        Height="680"
        MinWidth="720"
        MinHeight="480">

  <DockPanel Margin="14">

    <!-- Status row -->
    <UniformGrid DockPanel.Dock="Top" Columns="3">
      <Border Margin="0,0,6,0" Padding="10" CornerRadius="6" Background="#22FFFFFF">
        <StackPanel Spacing="2">
          <TextBlock Text="CONTROLLER" FontSize="11" Opacity="0.6" />
          <TextBlock Text="{Binding ControllerStatus}" FontWeight="SemiBold" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Margin="6,0" Padding="10" CornerRadius="6" Background="#22FFFFFF">
        <StackPanel Spacing="2">
          <TextBlock Text="AGENT" FontSize="11" Opacity="0.6" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding AgentStatus}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding AgentState}" Opacity="0.8" />
          </StackPanel>
          <TextBlock Text="{Binding SessionId}" FontSize="11" Opacity="0.5" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
      <Border Margin="6,0,0,0" Padding="10" CornerRadius="6" Background="#22FFFFFF">
        <StackPanel Spacing="2">
          <TextBlock Text="PROFILE" FontSize="11" Opacity="0.6" />
          <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- Approval banner -->
    <Border DockPanel.Dock="Top"
            Margin="0,10,0,0"
            Padding="10"
            CornerRadius="6"
            Background="#40FF8C00"
            IsVisible="{Binding HasPendingApproval}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="Approval required:" FontWeight="Bold" VerticalAlignment="Center" />
        <TextBlock Text="{Binding PendingApprovalMessage}"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="360" />
        <Button Content="Approve once" Command="{Binding ApproveOnceCommand}" />
        <Button Content="Approve for session" Command="{Binding ApproveSessionCommand}" />
        <Button Content="Decline" Command="{Binding DeclineCommand}" />
        <Button Content="Cancel" Command="{Binding CancelCommand}" />
      </StackPanel>
    </Border>

    <!-- Prompt row -->
    <DockPanel DockPanel.Dock="Top" Margin="0,10,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="6,0,0,0">
        <Button Content="Submit" Command="{Binding SubmitPromptCommand}" />
        <Button Content="Interrupt" Command="{Binding InterruptCommand}" />
        <Button Content="Review" Command="{Binding ReviewCommand}" />
        <Button Content="New session" Command="{Binding NewSessionCommand}" />
        <Button Content="Edit profile…" Click="OnEditProfile" />
      </StackPanel>
      <TextBox Text="{Binding PromptText}" Watermark="Prompt to send (empty = default prompt)" />
    </DockPanel>

    <!-- Haptics preview -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
      <TextBlock Text="Haptics:" VerticalAlignment="Center" Opacity="0.7" />
      <Button Content="Working" Command="{Binding PlayPatternCommand}" CommandParameter="working" />
      <Button Content="Approval" Command="{Binding PlayPatternCommand}" CommandParameter="approval" />
      <Button Content="Waiting" Command="{Binding PlayPatternCommand}" CommandParameter="waiting" />
      <Button Content="Completed" Command="{Binding PlayPatternCommand}" CommandParameter="completed" />
      <Button Content="Error" Command="{Binding PlayPatternCommand}" CommandParameter="error" />
      <Button Content="Stop" Command="{Binding PlayPatternCommand}" CommandParameter="stop" />
    </StackPanel>

    <!-- Log + bindings -->
    <Grid ColumnDefinitions="3*,2*" Margin="0,10,0,0">
      <Border Padding="6" CornerRadius="6" Background="#18FFFFFF" Margin="0,0,6,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="EVENTS" FontSize="11" Opacity="0.6" Margin="4,0,0,4" />
          <ListBox ItemsSource="{Binding Log}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" />
        </DockPanel>
      </Border>
      <Border Grid.Column="1" Padding="6" CornerRadius="6" Background="#18FFFFFF" Margin="6,0,0,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="ACTIVE BINDINGS" FontSize="11" Opacity="0.6" Margin="4,0,0,4" />
          <ListBox ItemsSource="{Binding Bindings}" FontSize="12" />
        </DockPanel>
      </Border>
    </Grid>

  </DockPanel>
</Window>
