<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gui="using:CtrlAgent.Gui"
        x:Class="CtrlAgent.Gui.MainWindow"
        x:DataType="gui:MainViewModel"
        Title="CtrlAgent"
        Icon="avares://CtrlAgent.Gui/Assets/icon.png"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        Width="980"
        Height="760"
        MinWidth="740"
        MinHeight="660">

  <Window.Styles>
    <!-- First-run card: rises and settles once, so the app opens rather than
         blinks into existence. Base state is set in markup because Avalonia
         renders an element's own value during Animation.Delay. -->
    <Style Selector="Border.setupCard">
      <Style.Animations>
        <Animation Duration="0:0:0.65" Delay="0:0:0.1" IterationCount="1"
                   FillMode="Forward" Easing="CubicEaseOut">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="22" />
            <Setter Property="ScaleTransform.ScaleX" Value="0.97" />
            <Setter Property="ScaleTransform.ScaleY" Value="0.97" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- Conversation view: prose as chat bubbles, tool/status lines as
         small dim activity rows — the Claude-app layout -->
    <Style Selector="ListBox.chat ListBoxItem">
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.bubble">
      <Setter Property="Background" Value="#CC17233C" />
      <Setter Property="BorderBrush" Value="#1FFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="MaxWidth" Value="400" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.bubble.user">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Background" Value="#33194B66" />
      <Setter Property="BorderBrush" Value="#5900D4FF" />
    </Style>
    <Style Selector="TextBlock.activityRow">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#7B93BC" />
      <Setter Property="Margin" Value="2,0" />
    </Style>
  </Window.Styles>

  <Panel>
  <gui:AmbientBackdrop />

  <!-- Client area extends into the title bar; leave room for caption buttons -->
  <DockPanel Margin="26,40,26,22">

    <!-- ===================== COMMAND BAR =====================
         Hero and status used to be two stacked cards with a wordmark in the
         middle of the first one. The wordmark was the widest thing on screen
         and told you nothing you did not already know — you are looking at the
         app. Dropping it and merging the two cards gives ~90px back to the
         conversation, which is the part you actually read.

         One surface, two rows: who you are talking to, then what you can
         change about it. Still the window drag handle. -->
    <Border DockPanel.Dock="Top"
            Name="HeroBand"
            PointerPressed="OnHeroPressed"
            Classes="card"
            CornerRadius="18"
            Padding="20,14"
            Margin="0,0,0,12">
      <StackPanel Spacing="12">

        <!-- Row 1 — the companion, and the window-level tools -->
        <DockPanel>
          <Border DockPanel.Dock="Right"
                  VerticalAlignment="Center"
                  Background="#4D0E1728"
                  BorderBrush="#1FFFFFFF"
                  BorderThickness="1"
                  CornerRadius="13"
                  Padding="4,3">
            <StackPanel Orientation="Horizontal" Spacing="1">
              <Button Classes="tool" Command="{Binding ReviewCommand}"
                      ToolTip.Tip="Ask the agent to review the working tree (X on the controller)">
<TextBlock Text="◱" FontSize="13" VerticalAlignment="Center" />
              </Button>
              <Rectangle Width="1" Fill="#14FFFFFF" Margin="3,5" />
              <Button Classes="tool" Command="{Binding NewSessionCommand}"
                      ToolTip.Tip="Start a fresh session (Menu on the controller)">
<TextBlock Text="✦" FontSize="13" VerticalAlignment="Center" />
              </Button>
              <Rectangle Width="1" Fill="#14FFFFFF" Margin="3,5" />
              <Button Classes="tool" Click="OnShowMainframe"
                      ToolTip.Tip="Mainframe — fullscreen controller-first mode (F11, Xbox/PS button, or double-press View)">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <TextBlock Text="⛶" FontSize="13" VerticalAlignment="Center" />
                  <TextBlock Text="Mainframe" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Rectangle Width="1" Fill="#14FFFFFF" Margin="3,5" />
              <Button Classes="tool" Click="OnToggleOverlay" ToolTip.Tip="Toggle the always-on-top HUD">
                <TextBlock Text="▤" FontSize="13" VerticalAlignment="Center" />
              </Button>
              <Button Classes="tool" Click="OnEditProfile"
                      ToolTip.Tip="Edit controller bindings with live validation">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <TextBlock Text="⚙" FontSize="13" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding ProfileName}" VerticalAlignment="Center" />
                  <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{Binding ProfileDotBrush}" />
                </StackPanel>
              </Button>
              <Button Classes="tool" Click="OnValidateHardware" ToolTip.Tip="Run the guided hardware validation wizard">
                <TextBlock Text="◎" FontSize="13" VerticalAlignment="Center" />
              </Button>
            </StackPanel>
          </Border>

          <!-- CTRL·BOT and the line it is currently coaching -->
          <StackPanel Orientation="Horizontal"
                      Spacing="12"
                      VerticalAlignment="Center"
                      DataContext="{Binding Buddy}"
                      x:DataType="gui:AgentBuddyViewModel">
            <Viewbox Height="76" Stretch="Uniform">
              <gui:BotView />
            </Viewbox>
            <Border Background="#7A17243E"
                    BorderBrush="#14FFFFFF"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14,9"
                    MaxWidth="360"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding Message}"
                         TextWrapping="Wrap"
                         FontSize="12.5"
                         Foreground="#CFE1FF" />
            </Border>
          </StackPanel>
        </DockPanel>

        <Rectangle Height="1" Fill="#14FFFFFF" />

        <!-- Row 2 — what the session is, and the knobs that change it -->
        <DockPanel LastChildFill="False">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"
                      VerticalAlignment="Center" Margin="16,0,0,0">
            <Button Content="{Binding PermissionModeLabel}" Command="{Binding CyclePermissionModeCommand}"
                    Classes="knob"
                    ToolTip.Tip="Cycle the agent's permission mode: default, plan, acceptEdits, auto, dontAsk" />
            <Button Content="{Binding ModelLabel}" Command="{Binding CycleModelCommand}"
                    Classes="knob" ToolTip.Tip="Cycle the model: default, sonnet, opus, haiku, fable" />
            <Button Content="{Binding EffortLabel}" Command="{Binding CycleEffortCommand}"
                    Classes="knob" ToolTip.Tip="Cycle reasoning effort: low, medium, high, xhigh, max" />
            <Button Content="compact" Command="{Binding CompactCommand}"
                    Classes="knob" ToolTip.Tip="Compact the conversation, freeing context" />
          </StackPanel>

          <WrapPanel ItemSpacing="16" LineSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
              <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                       Fill="{Binding AgentDotBrush}" Classes.pulse="{Binding IsAgentActive}" />
              <StackPanel Spacing="1">
                <TextBlock Text="AGENT" Classes="label" FontSize="9" />
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <TextBlock Text="{Binding AgentStatus}" FontSize="13" FontWeight="Medium" Foreground="#E6EFFB" />
                  <TextBlock Text="{Binding AgentState}" FontSize="13" Foreground="#7DD3FC" />
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <Rectangle Width="1" Height="28" Fill="#14FFFFFF" VerticalAlignment="Center" />

            <Button Classes="ghost" Padding="8,4" Command="{Binding PickWorkspaceCommand}"
                    VerticalAlignment="Center" Cursor="Hand" ToolTip.Tip="{Binding WorkspacePath}">
              <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <TextBlock Text="🗂" FontSize="12" VerticalAlignment="Center" Foreground="#6B84AD" />
                <StackPanel Spacing="1">
                  <TextBlock Text="WORKSPACE" Classes="label" FontSize="9" />
                  <TextBlock Text="{Binding WorkspaceName}" FontSize="13" FontWeight="Medium"
                             Foreground="#E6EFFB" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                </StackPanel>
              </StackPanel>
            </Button>

            <Rectangle Width="1" Height="28" Fill="#14FFFFFF" VerticalAlignment="Center" />

            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
              <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                       Fill="{Binding ControllerDotBrush}" Classes.pulse="{Binding IsControllerSearching}" />
              <StackPanel Spacing="1">
                <TextBlock Text="CONTROLLER" Classes="label" FontSize="9" />
                <TextBlock Text="{Binding ControllerStatus}" FontSize="13" FontWeight="Medium"
                           Foreground="#E6EFFB" TextTrimming="CharacterEllipsis" MaxWidth="240" />
              </StackPanel>
            </StackPanel>

          </WrapPanel>
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- ===================== COMPOSER =====================
         One primary action, not four peers. Review and New session moved up to
         the tool rail because they are session-level, and Interrupt appears
         only while there is a turn to interrupt — a permanently-lit stop button
         is noise for the 90% of the time nothing is running. -->
    <DockPanel DockPanel.Dock="Top">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                  Margin="10,0,0,0" VerticalAlignment="Bottom">
        <Border Background="#33FFB020" BorderBrush="#66FFB020" BorderThickness="1"
                CornerRadius="8" Padding="8,2" VerticalAlignment="Center"
                IsVisible="{Binding HasQueuedPrompts}"
                ToolTip.Tip="Prompts waiting to send when the current turn ends">
          <TextBlock Text="{Binding QueuedPromptLabel}" FontSize="10" Foreground="#FFD9A0" />
        </Border>
        <Button Command="{Binding StartVoiceCommand}" Padding="12,9"
                ToolTip.Tip="Speak a prompt (Y on the controller)">
          <Path Classes="icon"
                Data="M9,2.5 A2.6,2.6 0 0 1 11.6,5.1 L11.6,9.4 A2.6,2.6 0 0 1 6.4,9.4
                      L6.4,5.1 A2.6,2.6 0 0 1 9,2.5 Z
                      M4.2,9.2 A4.8,4.8 0 0 0 13.8,9.2
                      M9,14 L9,16.2 M6.4,16.2 L11.6,16.2" />
        </Button>
        <Button Command="{Binding AttachFileCommand}" Padding="12,9"
                ToolTip.Tip="Attach files for the next prompt (LB+X on the controller)">
          <Path Classes="icon"
                Data="M12.6,5.2 L6.4,11.4 A2.4,2.4 0 0 0 9.8,14.8 L15.2,9.4
                      A4,4 0 0 0 9.6,3.8 L4.2,9.2 A5.6,5.6 0 0 0 12.2,17.2" />
        </Button>
        <Button Content="Interrupt" Classes="deny" Padding="16,10"
                Command="{Binding InterruptCommand}"
                IsVisible="{Binding IsAgentActive}"
                ToolTip.Tip="Stop the current turn (B on the controller)" />
        <Button Content="Submit" Classes="accent" FontSize="14" Padding="22,10"
                Command="{Binding SubmitPromptCommand}" />
      </StackPanel>

      <TextBox Text="{Binding PromptText}"
               FontSize="14"
               Padding="16,11"
               AcceptsReturn="True"
               AcceptsTab="False"
               TextWrapping="Wrap"
               MaxHeight="132"
               VerticalContentAlignment="Top"
               x:Name="PromptBox"
               Watermark="Ask the agent anything — Enter submits, Shift+Enter for a new line" />
    </DockPanel>


    <!-- Attached files: shown under the prompt because they are part of what
         the next Submit sends, not a separate thing that happened. -->
    <Border DockPanel.Dock="Top"
            Classes="card"
            Padding="12,8"
            Margin="0,8,0,0"
            IsVisible="{Binding HasAttachments}">
      <DockPanel>
        <Button DockPanel.Dock="Right"
                Classes="ghost"
                Content="Clear"
                FontSize="11"
                Command="{Binding ClearAttachmentsCommand}" />
        <TextBlock DockPanel.Dock="Left"
                   Text="📎"
                   FontSize="13"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0" />
        <StackPanel Spacing="3">
          <TextBlock Text="{Binding AttachmentLabel}" Classes="label" FontSize="9" />
          <ItemsControl ItemsSource="{Binding Attachments}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Border Background="#4D0E1728" BorderBrush="#1FFFFFFF" BorderThickness="1"
                        CornerRadius="6" Padding="7,2">
                  <TextBlock Text="{Binding}"
                             FontSize="11"
                             Foreground="#B9CCEF"
                             MaxWidth="320"
                             TextTrimming="CharacterEllipsis" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Approval banner: docked in the flow directly under the prompt row, so
         it pushes content down rather than covering the controls you need to
         answer with. It kept a hardcoded top margin when it floated, which
         landed it on top of the prompt row at every window size. -->
    <Border DockPanel.Dock="Top"
            Classes="alert approvalBanner"
            Classes.show="{Binding HasPendingApproval}"
            Margin="0,12,0,0"
            Padding="14,10"
            BoxShadow="0 6 28 0 #66FFB020"
            IsVisible="{Binding HasPendingApproval}">
      <!-- Buttons dock right and keep their full width; the message takes
           whatever is left. A fixed-width message pushed Cancel off the edge
           of the banner — the one control you need to stop a bad write. -->
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Spacing="6"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center">
          <Button Content="Approve once" Classes="approve" Command="{Binding ApproveOnceCommand}" />
          <Button Content="Approve for session" Classes="approve" Command="{Binding ApproveSessionCommand}" />
          <Button Content="Decline" Classes="deny" Command="{Binding DeclineCommand}" />
          <Button Content="Cancel" Classes="deny" Command="{Binding CancelCommand}" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Left"
                   Text="APPROVAL REQUIRED"
                   Classes="label"
                   Foreground="#FFD9A0"
                   Opacity="1"
                   Margin="0,0,10,0"
                   VerticalAlignment="Center" />
        <TextBlock Text="{Binding PendingApprovalMessage}"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis"
                   MaxLines="2"
                   Foreground="#FFEFD6" />
      </DockPanel>
    </Border>

    <!-- Sessions + log + live input + bindings -->
    <Grid ColumnDefinitions="Auto,3*,2*" Margin="0,14,0,0">

      <!-- Recents sidebar (Claude-app style): every session the agent's
           on-disk store knows for this workspace, newest first — click one to
           resume it. Auto column, so hiding it (non-Claude adapters have no
           readable store yet) collapses the space entirely. -->
      <Border Grid.Column="0"
              Classes="card"
              Padding="12,14"
              Margin="0,0,9,0"
              Width="212"
              IsVisible="{Binding IsSessionListVisible}">
        <Border.Styles>
          <Style Selector="Button.sessionRow">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="CornerRadius" Value="8" />
          </Style>
          <Style Selector="Button.sessionRow.current">
            <Setter Property="BorderBrush" Value="#5900D4FF" />
            <Setter Property="Background" Value="#1400D4FF" />
          </Style>
        </Border.Styles>
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="4,0,0,8">
            <Button DockPanel.Dock="Right"
                    Classes="ghost"
                    Padding="8,5"
                    Command="{Binding RefreshSessionsCommand}"
                    ToolTip.Tip="Refresh the session list">
              <Path Classes="icon"
                    Data="M14.2,9 A5.2,5.2 0 1 1 12.7,5.3 M12.7,2.6 L12.7,5.6 L9.7,5.6" />
            </Button>
            <TextBlock Text="SESSIONS" Classes="label" VerticalAlignment="Center" />
          </DockPanel>
          <Button DockPanel.Dock="Top"
                  Content="+ New chat"
                  Classes="accent"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Margin="0,0,0,10"
                  Command="{Binding NewSessionCommand}" />
          <Panel>
            <TextBlock Classes="placeholder"
                       Text="No sessions yet"
                       IsVisible="{Binding IsSessionsEmpty}" />
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Sessions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="gui:SessionListItem">
                    <Button Classes="ghost sessionRow"
                            Classes.current="{Binding IsCurrent}"
                            Command="{Binding ResumeCommand}"
                            ToolTip.Tip="{Binding SessionId}">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Title}"
                                   TextWrapping="Wrap"
                                   MaxLines="2"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="11.5"
                                   Foreground="#D7E4FA" />
                        <TextBlock Text="{Binding WhenLabel}"
                                   FontSize="10"
                                   Foreground="#5A7099" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Panel>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Classes="card" Padding="16,14" Margin="0,0,9,0">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="4,0,0,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
              <ToggleButton Classes="chip"
                            Content="conversation"
                            IsChecked="{Binding IsChatView}"
                            ToolTip.Tip="Toggle between the conversation and the raw event stream" />
              <ToggleButton Classes="chip"
                            Content="controller input"
                            IsChecked="{Binding ShowControllerEvents}"
                            IsVisible="{Binding !IsChatView}"
                            ToolTip.Tip="Show or hide raw controller input lines" />
            </StackPanel>
            <TextBlock Text="ACTIVITY" Classes="label" VerticalAlignment="Center" />
          </DockPanel>
          <Panel>

          <!-- Conversation: what you said, what the agent replied, and what
               it did in between -->
          <Panel IsVisible="{Binding IsChatView}">
          <!-- Empty state: one quiet line and one hint, centered in the
               space. A long sentence floating in a void reads as an error. -->
          <StackPanel Spacing="7"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsVisible="{Binding IsTranscriptEmpty}">
            <Ellipse Width="34" Height="34" HorizontalAlignment="Center"
                     Fill="#12FFFFFF" Stroke="#1FFFFFFF" StrokeThickness="1" />
            <TextBlock Text="Nothing yet"
                       FontSize="13"
                       Foreground="#7B93BC"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Type a prompt, or press A on the controller"
                       FontSize="11.5"
                       Foreground="#4C6A93"
                       HorizontalAlignment="Center" />
          </StackPanel>
          <ListBox x:Name="ChatList"
                   Classes="chat"
                   ItemsSource="{Binding Transcript}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="gui:ChatMessage">
                <Panel>
                  <TextBlock Classes="activityRow"
                             Text="{Binding Text}"
                             TextWrapping="Wrap"
                             IsVisible="{Binding IsActivity}" />
                  <Border Classes="bubble"
                          Classes.user="{Binding IsUser}"
                          IsVisible="{Binding !IsActivity}">
                    <gui:MarkdownView Markdown="{Binding Text}" />
                  </Border>
                </Panel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          </Panel>

          <Panel IsVisible="{Binding !IsChatView}">
          <TextBlock Classes="placeholder"
                     Text="No events yet — controller and agent activity will stream here."
                     IsVisible="{Binding IsLogEmpty}" />
          <ListBox x:Name="EventStream"
                   ItemsSource="{Binding Log}"
                   FontFamily="Cascadia Mono,Consolas,monospace"
                   FontSize="12">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="MinHeight" Value="0" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="gui:LogEntry">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Timestamp}" Foreground="#5A7099" />
                  <TextBlock Text="{Binding Message}"
                             Foreground="{Binding Brush}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          </Panel>

          </Panel>
        </DockPanel>
      </Border>

      <!-- Proportional rows, not Top-docked + fill. Docked, the mirror card
           took its full desired height first, so on a short window it ate the
           whole column: ACTIVE BINDINGS disappeared entirely and the mirror
           drew straight over the HAPTICS chips. Stars mean both cards always
           get a share and the mirror scales into whatever it is given. -->
      <Grid Grid.Column="2" Margin="9,0,0,0" RowDefinitions="3*,2*">

        <!-- Live controller mirror: every control lights up as it is used -->
        <Border Grid.Row="0" Classes="card" Padding="16,14" Margin="0,0,0,9">
          <DockPanel>

            <!-- Haptic preview chips: fire a pattern on the mirrored controller -->
            <WrapPanel DockPanel.Dock="Bottom" Margin="4,8,0,0" ItemSpacing="1" LineSpacing="2">
              <WrapPanel.Styles>
                <Style Selector="Button">
                  <Setter Property="FontSize" Value="11" />
                  <Setter Property="Padding" Value="8,3" />
                </Style>
              </WrapPanel.Styles>
              <TextBlock Text="HAPTICS" Classes="label" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Button Content="Working" Classes="ghost" Command="{Binding PlayPatternCommand}" CommandParameter="working" />
              <Button Content="Approval" Classes="ghost" Command="{Binding PlayPatternCommand}" CommandParameter="approval" />
              <Button Content="Waiting" Classes="ghost" Command="{Binding PlayPatternCommand}" CommandParameter="waiting" />
              <Button Content="Completed" Classes="ghost" Command="{Binding PlayPatternCommand}" CommandParameter="completed" />
              <Button Content="Error" Classes="ghost" Command="{Binding PlayPatternCommand}" CommandParameter="error" />
              <Button Content="Stop" Classes="ghost" Foreground="#E08496" Command="{Binding PlayPatternCommand}" CommandParameter="stop" />
            </WrapPanel>

          <!-- DockPanel, not StackPanel: a StackPanel hands each child its
               full desired height and never compresses, so the mirror spilled
               over the haptics row instead of shrinking. Here it fills what is
               left and its Viewbox scales to fit. -->
          <DockPanel DataContext="{Binding ControllerVisual}" x:DataType="gui:ControllerVisualViewModel">
            <TextBlock DockPanel.Dock="Top" Text="LIVE INPUT" Classes="label" Margin="4,0,0,6" />
            <!-- Elite Series 2 layout: asymmetric Xbox sticks, hybrid d-pad
                 disc, notched stick rings, guide button, rear paddle blades. -->
            <gui:ControllerMirrorView MaxHeight="230" />
          </DockPanel>
          </DockPanel>
        </Border>

        <Border Grid.Row="1" Classes="card" Padding="16,14">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="ACTIVE BINDINGS" Classes="label" Margin="4,0,0,6" />
            <Panel>
            <TextBlock Classes="placeholder"
                       Text="No bindings — open Profile… to add some."
                       IsVisible="{Binding IsBindingsEmpty}" />
            <ListBox ItemsSource="{Binding Bindings}" FontSize="12">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="6,3" />
                  <Setter Property="MinHeight" Value="0" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="gui:BindingRow">
                  <DockPanel>
                    <Border DockPanel.Dock="Left"
                            Background="#4D0E1728"
                            BorderBrush="#1FFFFFFF"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="6,2"
                            MinWidth="84"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding Chord}"
                                 FontFamily="Cascadia Mono,Consolas,monospace"
                                 FontSize="11"
                                 Foreground="#7DD3FC"
                                 HorizontalAlignment="Center" />
                    </Border>
                    <Border DockPanel.Dock="Right"
                            Background="#33FFB020"
                            CornerRadius="4"
                            Padding="5,1"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsApproval}">
                      <TextBlock Text="approval" FontSize="9" Foreground="#FFD9A0" />
                    </Border>
                    <TextBlock Text="{Binding Action}"
                               Margin="8,0"
                               VerticalAlignment="Center"
                               Foreground="#B9CCEF" />
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            </Panel>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>

  </DockPanel>

  <!-- Startup failure. Same treatment as first-run: a dead app is a screen in
       its own right, not a modal over a greyed-out UI that is not running.
       Showing the disabled app behind it invited people to poke at controls
       that do nothing. -->
  <Border IsVisible="{Binding HasStartupError}" Background="#05080F">
    <Panel>
      <gui:AmbientBackdrop />

      <Border Classes="card setupCard"
              Opacity="0"
              MaxWidth="560"
              Padding="40,34"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Background="#26150E14"
              BorderBrush="#66FF5A78"
              RenderTransformOrigin="50%,50%">
        <StackPanel Spacing="18">
          <StackPanel Spacing="10">
            <Image Source="avares://CtrlAgent.Gui/Assets/logo.png"
                   Height="56"
                   Opacity="0.5"
                   HorizontalAlignment="Center"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Text="COULDN'T START"
                       Classes="label"
                       FontSize="11"
                       LetterSpacing="3"
                       Foreground="#FF9AA8"
                       TextAlignment="Center"
                       HorizontalAlignment="Center" />
          </StackPanel>

          <Rectangle Height="1" Fill="#33FF5A78" />

          <TextBlock Text="{Binding StartupError}"
                     FontSize="14"
                     Foreground="#FFD9DF"
                     TextWrapping="Wrap"
                     TextAlignment="Center" />

          <TextBlock Text="Nothing is connected and no bindings are active until this is resolved. If you passed command-line flags, check that any path containing spaces is quoted."
                     FontSize="12"
                     Foreground="#9FB7DF"
                     TextWrapping="Wrap"
                     TextAlignment="Center" />

          <Button Content="Change settings…"
                  Classes="accent"
                  FontSize="14"
                  Padding="14,10"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Command="{Binding DismissStartupErrorCommand}" />
        </StackPanel>
      </Border>
    </Panel>
  </Border>

  <!-- First-run setup: the very first thing anyone sees. It used to be a
       plain card over a dimmed screenshot of an app you had not started yet,
       with the wordmark greyed out behind the scrim — the one moment the
       product introduces itself, spent showing a disabled UI. Now it is its
       own screen: opaque, on the shared field, brand first. -->
  <Border IsVisible="{Binding IsSetupVisible}" Background="#05080F">
    <Panel>
      <gui:AmbientBackdrop />

      <Border Classes="card setupCard" Opacity="0" MaxWidth="520" Padding="40,34"
              VerticalAlignment="Center" HorizontalAlignment="Center"
              RenderTransformOrigin="50%,50%">
        <StackPanel Spacing="18">

          <StackPanel Spacing="10">
            <Image Source="avares://CtrlAgent.Gui/Assets/logo.png"
                   Height="72"
                   HorizontalAlignment="Center"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Text="CONTROLLER INTERFACE FOR AI CODING AGENTS"
                       Classes="label"
                       FontSize="9"
                       LetterSpacing="2.6"
                       TextAlignment="Center"
                       HorizontalAlignment="Center" />
          </StackPanel>

          <Rectangle Height="1" Fill="#14FFFFFF" />

          <TextBlock Text="Pick the agent to drive and the repository to work in. Saved for next launch — command-line flags always override."
                     FontSize="12.5"
                     Foreground="#9FB7DF"
                     TextWrapping="Wrap"
                     TextAlignment="Center" />

          <StackPanel Spacing="6">
            <TextBlock Text="AGENT PLATFORM" Classes="label" FontSize="9" />
            <ComboBox ItemsSource="{x:Static gui:MainViewModel.SetupAgents}"
                      SelectedItem="{Binding SetupAgent}"
                      HorizontalAlignment="Stretch" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="WORKING DIRECTORY" Classes="label" FontSize="9" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="OnBrowseWorkingDirectory" />
              <TextBox Text="{Binding SetupWorkingDirectory}" />
            </DockPanel>
          </StackPanel>

          <TextBlock Text="{Binding SetupError}"
                     Foreground="#FF7A6E"
                     FontSize="12"
                     TextWrapping="Wrap"
                     IsVisible="{Binding SetupError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <Button Content="Start"
                  Classes="accent"
                  FontSize="14"
                  Padding="14,10"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Command="{Binding StartSetupCommand}" />

          <TextBlock Text="mock is the safe demo agent — no real AI calls. codex and claude need their CLI installed and authenticated."
                     FontSize="11"
                     Foreground="#5A7099"
                     TextWrapping="Wrap"
                     TextAlignment="Center" />
        </StackPanel>
      </Border>
    </Panel>
  </Border>
  </Panel>
</Window>
