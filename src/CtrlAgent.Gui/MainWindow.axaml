<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gui="using:CtrlAgent.Gui"
        x:Class="CtrlAgent.Gui.MainWindow"
        x:DataType="gui:MainViewModel"
        Title="CtrlAgent"
        Icon="avares://CtrlAgent.Gui/Assets/icon.png"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        Width="980"
        Height="760"
        MinWidth="740"
        MinHeight="560">

  <Window.Styles>
    <!-- Conversation view: prose as chat bubbles, tool/status lines as
         small dim activity rows — the Claude-app layout -->
    <Style Selector="ListBox.chat ListBoxItem">
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.bubble">
      <Setter Property="Background" Value="#CC17233C" />
      <Setter Property="BorderBrush" Value="#1FFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="MaxWidth" Value="400" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.bubble.user">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Background" Value="#33194B66" />
      <Setter Property="BorderBrush" Value="#5900D4FF" />
    </Style>
    <Style Selector="TextBlock.activityRow">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#7B93BC" />
      <Setter Property="Margin" Value="2,0" />
    </Style>
  </Window.Styles>

  <Panel>
  <!-- Client area extends into the title bar; leave room for caption buttons -->
  <DockPanel Margin="16,38,16,16">

    <!-- Hero: slim single-band header — bot | wordmark | utility cluster.
         Doubles as the window drag handle now that the title bar is gone. -->
    <Border DockPanel.Dock="Top"
            Name="HeroBand"
            PointerPressed="OnHeroPressed"
            CornerRadius="12"
            Padding="16,10"
            Margin="0,0,0,10"
            BoxShadow="0 0 32 0 #2E00D4FF">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#F00A1526" Offset="0" />
          <GradientStop Color="#F0102A50" Offset="0.55" />
          <GradientStop Color="#F0081226" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <!-- Overlay layout: the wordmark is window-centered and immune to how
           wide the bot's speech bubble or the utility cluster happen to be. -->
      <Panel>

        <!-- CTRL·BOT: the resident agent companion -->
        <StackPanel Orientation="Horizontal"
                    Spacing="12"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    DataContext="{Binding Buddy}"
                    x:DataType="gui:AgentBuddyViewModel">
          <Viewbox Height="88" Stretch="Uniform">
            <gui:BotView />
          </Viewbox>

          <!-- Speech bubble: fixed width so the text can never reflow the band -->
          <Border Background="#C0122038"
                  BorderBrush="#552E4A78"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="12,8"
                  Width="212"
                  VerticalAlignment="Center"
                  BoxShadow="0 2 12 0 #1A00D4FF">
            <TextBlock Text="{Binding Message}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="#CFE1FF" />
          </Border>
        </StackPanel>

        <!-- Wordmark: dead-center of the band, never moves -->
        <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
          <Image Source="avares://CtrlAgent.Gui/Assets/logo.png"
                 Height="52"
                 HorizontalAlignment="Center"
                 RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock Text="CONTROLLER INTERFACE FOR AI CODING AGENTS"
                     Classes="label"
                     FontSize="9"
                     HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Utility cluster: window-level tools live up here, off the action row -->
        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="Big Picture"
                  Click="OnShowBigPicture"
                  ToolTip.Tip="Fullscreen controller-first mode: navigate with the pad, speak prompts, see every shortcut" />
          <Button Content="Overlay" Click="OnToggleOverlay" ToolTip.Tip="Toggle the always-on-top HUD" />
          <Button Content="Profile…" Click="OnEditProfile" ToolTip.Tip="Edit controller bindings with live validation" />
          <Button Content="Validate…" Click="OnValidateHardware" ToolTip.Tip="Run the guided hardware validation wizard" />
        </StackPanel>
      </Panel>
    </Border>

    <!-- Status row -->
    <UniformGrid DockPanel.Dock="Top" Columns="3">
      <Border Classes="card" Margin="0,0,6,0" Padding="12,10">
        <StackPanel Spacing="3">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                     Fill="{Binding ControllerDotBrush}"
                     Classes.pulse="{Binding IsControllerSearching}" />
            <TextBlock Text="CONTROLLER" Classes="label" />
          </StackPanel>
          <TextBlock Text="{Binding ControllerStatus}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#EAF3FF" />
        </StackPanel>
      </Border>
      <Border Classes="card" Margin="6,0" Padding="12,10">
        <StackPanel Spacing="3">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                     Fill="{Binding AgentDotBrush}"
                     Classes.pulse="{Binding IsAgentActive}" />
            <TextBlock Text="AGENT" Classes="label" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding AgentStatus}" FontWeight="SemiBold" Foreground="#EAF3FF" />
            <TextBlock Text="{Binding AgentState}" Foreground="#7DD3FC" />
            <Button Content="{Binding PermissionModeLabel}"
                    Command="{Binding CyclePermissionModeCommand}"
                    FontSize="10"
                    Padding="8,1"
                    CornerRadius="8"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Cycle the agent's permission mode: default → plan → acceptEdits (Claude Code; other adapters report unsupported)" />
          </StackPanel>
          <TextBlock Text="{Binding SessionId}"
                     FontSize="11"
                     Opacity="0.5"
                     FontFamily="Cascadia Mono,Consolas,monospace"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
      <Border Classes="card" Margin="6,0,0,0" Padding="12,10">
        <StackPanel Spacing="3">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding ProfileDotBrush}" />
            <TextBlock Text="PROFILE" Classes="label" />
          </StackPanel>
          <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold" Foreground="#EAF3FF" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- Action row: the only always-visible command strip -->
    <DockPanel DockPanel.Dock="Top" Margin="0,10,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="6,0,0,0">
        <Border Background="#33FFB020"
                BorderBrush="#66FFB020"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8,2"
                VerticalAlignment="Center"
                IsVisible="{Binding HasQueuedPrompts}"
                ToolTip.Tip="Prompts waiting to send when the current turn ends">
          <TextBlock Text="{Binding QueuedPromptLabel}" FontSize="10" Foreground="#FFD9A0" />
        </Border>
        <Button Content="Submit" Classes="accent" Command="{Binding SubmitPromptCommand}" />
        <Button Content="Interrupt" Command="{Binding InterruptCommand}" />
        <Button Content="Review" Command="{Binding ReviewCommand}" />
        <Button Content="New session" Command="{Binding NewSessionCommand}" />
      </StackPanel>
      <TextBox Text="{Binding PromptText}" Watermark="Prompt to send (empty = default prompt) — Enter submits">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding SubmitPromptCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
    </DockPanel>

    <!-- Log + live input + bindings -->
    <Grid ColumnDefinitions="3*,2*" Margin="0,10,0,0">
      <Border Classes="card" Padding="8" Margin="0,0,6,0">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="4,0,0,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
              <ToggleButton Classes="chip"
                            Content="conversation"
                            IsChecked="{Binding IsChatView}"
                            ToolTip.Tip="Toggle between the conversation and the raw event stream" />
              <ToggleButton Classes="chip"
                            Content="controller input"
                            IsChecked="{Binding ShowControllerEvents}"
                            IsVisible="{Binding !IsChatView}"
                            ToolTip.Tip="Show or hide raw controller input lines" />
            </StackPanel>
            <TextBlock Text="ACTIVITY" Classes="label" VerticalAlignment="Center" />
          </DockPanel>
          <Panel>

          <!-- Conversation: what you said, what the agent replied, and what
               it did in between -->
          <Panel IsVisible="{Binding IsChatView}">
          <TextBlock Classes="placeholder"
                     Text="No conversation yet — type a prompt and press Enter, or press A on the controller."
                     IsVisible="{Binding IsTranscriptEmpty}" />
          <ListBox x:Name="ChatList"
                   Classes="chat"
                   ItemsSource="{Binding Transcript}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="gui:ChatMessage">
                <Panel>
                  <TextBlock Classes="activityRow"
                             Text="{Binding Text}"
                             TextWrapping="Wrap"
                             IsVisible="{Binding IsActivity}" />
                  <Border Classes="bubble"
                          Classes.user="{Binding IsUser}"
                          IsVisible="{Binding !IsActivity}">
                    <TextBlock Text="{Binding Text}"
                               TextWrapping="Wrap"
                               FontSize="12.5"
                               Foreground="#E2EDFF" />
                  </Border>
                </Panel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          </Panel>

          <Panel IsVisible="{Binding !IsChatView}">
          <TextBlock Classes="placeholder"
                     Text="No events yet — controller and agent activity will stream here."
                     IsVisible="{Binding IsLogEmpty}" />
          <ListBox x:Name="EventStream"
                   ItemsSource="{Binding Log}"
                   FontFamily="Cascadia Mono,Consolas,monospace"
                   FontSize="12">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="MinHeight" Value="0" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="gui:LogEntry">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Timestamp}" Foreground="#5A7099" />
                  <TextBlock Text="{Binding Message}"
                             Foreground="{Binding Brush}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          </Panel>

          </Panel>
        </DockPanel>
      </Border>

      <DockPanel Grid.Column="1" Margin="6,0,0,0">

        <!-- Live controller mirror: every control lights up as it is used -->
        <Border DockPanel.Dock="Top" Classes="card" Padding="8" Margin="0,0,0,6">
          <DockPanel>

            <!-- Haptic preview chips: fire a pattern on the mirrored controller -->
            <WrapPanel DockPanel.Dock="Bottom" Margin="4,6,0,0" ItemSpacing="4" LineSpacing="4">
              <WrapPanel.Styles>
                <Style Selector="Button">
                  <Setter Property="FontSize" Value="11" />
                  <Setter Property="Padding" Value="9,3" />
                </Style>
              </WrapPanel.Styles>
              <TextBlock Text="HAPTICS" Classes="label" VerticalAlignment="Center" Margin="0,0,6,0" />
              <Button Content="Working" Command="{Binding PlayPatternCommand}" CommandParameter="working" />
              <Button Content="Approval" Command="{Binding PlayPatternCommand}" CommandParameter="approval" />
              <Button Content="Waiting" Command="{Binding PlayPatternCommand}" CommandParameter="waiting" />
              <Button Content="Completed" Command="{Binding PlayPatternCommand}" CommandParameter="completed" />
              <Button Content="Error" Command="{Binding PlayPatternCommand}" CommandParameter="error" />
              <Button Content="Stop" Classes="deny" Command="{Binding PlayPatternCommand}" CommandParameter="stop" />
            </WrapPanel>

          <StackPanel Spacing="4" DataContext="{Binding ControllerVisual}" x:DataType="gui:ControllerVisualViewModel">
            <TextBlock Text="LIVE INPUT" Classes="label" Margin="4,0,0,2" />
            <!-- Elite Series 2 layout: asymmetric Xbox sticks, hybrid d-pad
                 disc, notched stick rings, guide button, rear paddle blades. -->
            <gui:ControllerMirrorView MaxHeight="230" />
          </StackPanel>
          </DockPanel>
        </Border>

        <Border Classes="card" Padding="8">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="ACTIVE BINDINGS" Classes="label" Margin="4,0,0,6" />
            <Panel>
            <TextBlock Classes="placeholder"
                       Text="No bindings — open Profile… to add some."
                       IsVisible="{Binding IsBindingsEmpty}" />
            <ListBox ItemsSource="{Binding Bindings}" FontSize="12">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="6,3" />
                  <Setter Property="MinHeight" Value="0" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="gui:BindingRow">
                  <DockPanel>
                    <Border DockPanel.Dock="Left"
                            Background="#141F36"
                            BorderBrush="#552E4A78"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,1"
                            MinWidth="88"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding Chord}"
                                 FontFamily="Cascadia Mono,Consolas,monospace"
                                 FontSize="11"
                                 Foreground="#7DD3FC"
                                 HorizontalAlignment="Center" />
                    </Border>
                    <Border DockPanel.Dock="Right"
                            Background="#33FFB020"
                            CornerRadius="4"
                            Padding="5,1"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsApproval}">
                      <TextBlock Text="approval" FontSize="9" Foreground="#FFD9A0" />
                    </Border>
                    <TextBlock Text="{Binding Action}"
                               Margin="8,0"
                               VerticalAlignment="Center"
                               Foreground="#B9CCEF" />
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            </Panel>
          </DockPanel>
        </Border>
      </DockPanel>
    </Grid>

  </DockPanel>

  <!-- Approval banner: floats over the content instead of reflowing it -->
  <Border Classes="alert approvalBanner"
          Classes.show="{Binding HasPendingApproval}"
          VerticalAlignment="Top"
          HorizontalAlignment="Center"
          Margin="16,218,16,0"
          Padding="14,10"
          BoxShadow="0 6 28 0 #66FFB020"
          IsVisible="{Binding HasPendingApproval}">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <TextBlock Text="APPROVAL REQUIRED"
                 Classes="label"
                 Foreground="#FFD9A0"
                 Opacity="1"
                 VerticalAlignment="Center" />
      <TextBlock Text="{Binding PendingApprovalMessage}"
                 VerticalAlignment="Center"
                 TextWrapping="Wrap"
                 MaxWidth="330"
                 Foreground="#FFEFD6" />
      <Button Content="Approve once" Classes="approve" Command="{Binding ApproveOnceCommand}" />
      <Button Content="Approve for session" Classes="approve" Command="{Binding ApproveSessionCommand}" />
      <Button Content="Decline" Classes="deny" Command="{Binding DeclineCommand}" />
      <Button Content="Cancel" Classes="deny" Command="{Binding CancelCommand}" />
    </StackPanel>
  </Border>

  <!-- First-run setup overlay -->
  <Border IsVisible="{Binding IsSetupVisible}" Background="#E0060B14">
    <Border Classes="card" MaxWidth="480" Padding="26" VerticalAlignment="Center" HorizontalAlignment="Center">
      <StackPanel Spacing="12">
        <TextBlock Text="WELCOME TO CTRLAGENT" Classes="label" FontSize="12" HorizontalAlignment="Center" />
        <TextBlock Text="One-time setup: pick the agent to drive and the repository to work in. Saved for next launch — command-line flags always override."
                   FontSize="12"
                   Foreground="#9FB7DF"
                   TextWrapping="Wrap" />
        <TextBlock Text="Agent platform" FontSize="11" Opacity="0.6" />
        <ComboBox ItemsSource="{x:Static gui:MainViewModel.SetupAgents}"
                  SelectedItem="{Binding SetupAgent}"
                  HorizontalAlignment="Stretch" />
        <TextBlock Text="Working directory (your repository)" FontSize="11" Opacity="0.6" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Click="OnBrowseWorkingDirectory" />
          <TextBox Text="{Binding SetupWorkingDirectory}" />
        </DockPanel>
        <TextBlock Text="{Binding SetupError}"
                   Foreground="#FF7A6E"
                   FontSize="12"
                   TextWrapping="Wrap"
                   IsVisible="{Binding SetupError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Button Content="Start"
                Classes="accent"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Command="{Binding StartSetupCommand}" />
        <TextBlock Text="mock is the safe demo agent (no real AI calls). codex and claude need their CLI installed and authenticated."
                   FontSize="11"
                   Opacity="0.5"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Border>
  </Panel>
</Window>
