<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gui="using:CtrlAgent.Gui"
        x:Class="CtrlAgent.Gui.MainWindow"
        x:DataType="gui:MainViewModel"
        Title="CtrlAgent"
        Icon="avares://CtrlAgent.Gui/Assets/icon.png"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        Width="980"
        Height="760"
        MinWidth="740"
        MinHeight="560">

  <Panel>
  <!-- Client area extends into the title bar; leave room for caption buttons -->
  <DockPanel Margin="16,38,16,16">

    <!-- Hero: slim single-band header — bot | wordmark | utility cluster.
         Doubles as the window drag handle now that the title bar is gone. -->
    <Border DockPanel.Dock="Top"
            Name="HeroBand"
            PointerPressed="OnHeroPressed"
            CornerRadius="12"
            Padding="16,10"
            Margin="0,0,0,10"
            BoxShadow="0 0 32 0 #2E00D4FF">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#F00A1526" Offset="0" />
          <GradientStop Color="#F0102A50" Offset="0.55" />
          <GradientStop Color="#F0081226" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <!-- Overlay layout: the wordmark is window-centered and immune to how
           wide the bot's speech bubble or the utility cluster happen to be. -->
      <Panel>

        <!-- CTRL·BOT: the resident agent companion -->
        <StackPanel Orientation="Horizontal"
                    Spacing="12"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    DataContext="{Binding Buddy}"
                    x:DataType="gui:AgentBuddyViewModel">
          <Viewbox Height="88" Stretch="Uniform">
            <gui:BotView />
          </Viewbox>

          <!-- Speech bubble: fixed width so the text can never reflow the band -->
          <Border Background="#C0122038"
                  BorderBrush="#552E4A78"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="12,8"
                  Width="212"
                  VerticalAlignment="Center"
                  BoxShadow="0 2 12 0 #1A00D4FF">
            <TextBlock Text="{Binding Message}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="#CFE1FF" />
          </Border>
        </StackPanel>

        <!-- Wordmark: dead-center of the band, never moves -->
        <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
          <Image Source="avares://CtrlAgent.Gui/Assets/logo.png"
                 Height="52"
                 HorizontalAlignment="Center"
                 RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock Text="CONTROLLER INTERFACE FOR AI CODING AGENTS"
                     Classes="label"
                     FontSize="9"
                     HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Utility cluster: window-level tools live up here, off the action row -->
        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="Big Picture"
                  Click="OnShowBigPicture"
                  ToolTip.Tip="Fullscreen controller-first mode: navigate with the pad, speak prompts, see every shortcut" />
          <Button Content="Overlay" Click="OnToggleOverlay" ToolTip.Tip="Toggle the always-on-top HUD" />
          <Button Content="Profile…" Click="OnEditProfile" ToolTip.Tip="Edit controller bindings with live validation" />
          <Button Content="Validate…" Click="OnValidateHardware" ToolTip.Tip="Run the guided hardware validation wizard" />
        </StackPanel>
      </Panel>
    </Border>

    <!-- Status row -->
    <UniformGrid DockPanel.Dock="Top" Columns="3">
      <Border Classes="card" Margin="0,0,6,0" Padding="12,10">
        <StackPanel Spacing="3">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                     Fill="{Binding ControllerDotBrush}"
                     Classes.pulse="{Binding IsControllerSearching}" />
            <TextBlock Text="CONTROLLER" Classes="label" />
          </StackPanel>
          <TextBlock Text="{Binding ControllerStatus}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#EAF3FF" />
        </StackPanel>
      </Border>
      <Border Classes="card" Margin="6,0" Padding="12,10">
        <StackPanel Spacing="3">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                     Fill="{Binding AgentDotBrush}"
                     Classes.pulse="{Binding IsAgentActive}" />
            <TextBlock Text="AGENT" Classes="label" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding AgentStatus}" FontWeight="SemiBold" Foreground="#EAF3FF" />
            <TextBlock Text="{Binding AgentState}" Foreground="#7DD3FC" />
          </StackPanel>
          <TextBlock Text="{Binding SessionId}"
                     FontSize="11"
                     Opacity="0.5"
                     FontFamily="Cascadia Mono,Consolas,monospace"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
      <Border Classes="card" Margin="6,0,0,0" Padding="12,10">
        <StackPanel Spacing="3">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding ProfileDotBrush}" />
            <TextBlock Text="PROFILE" Classes="label" />
          </StackPanel>
          <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold" Foreground="#EAF3FF" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- Action row: the only always-visible command strip -->
    <DockPanel DockPanel.Dock="Top" Margin="0,10,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="6,0,0,0">
        <Button Content="Submit" Classes="accent" Command="{Binding SubmitPromptCommand}" />
        <Button Content="Interrupt" Command="{Binding InterruptCommand}" />
        <Button Content="Review" Command="{Binding ReviewCommand}" />
        <Button Content="New session" Command="{Binding NewSessionCommand}" />
      </StackPanel>
      <TextBox Text="{Binding PromptText}" Watermark="Prompt to send (empty = default prompt) — Enter submits">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding SubmitPromptCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
    </DockPanel>

    <!-- Log + live input + bindings -->
    <Grid ColumnDefinitions="3*,2*" Margin="0,10,0,0">
      <Border Classes="card" Padding="8" Margin="0,0,6,0">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="4,0,0,6">
            <ToggleButton DockPanel.Dock="Right"
                          Classes="chip"
                          Content="controller input"
                          IsChecked="{Binding ShowControllerEvents}"
                          ToolTip.Tip="Show or hide raw controller input lines" />
            <TextBlock Text="EVENT STREAM" Classes="label" VerticalAlignment="Center" />
          </DockPanel>
          <Panel>
          <TextBlock Classes="placeholder"
                     Text="No events yet — controller and agent activity will stream here."
                     IsVisible="{Binding IsLogEmpty}" />
          <ListBox x:Name="EventStream"
                   ItemsSource="{Binding Log}"
                   FontFamily="Cascadia Mono,Consolas,monospace"
                   FontSize="12">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="MinHeight" Value="0" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="gui:LogEntry">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Timestamp}" Foreground="#5A7099" />
                  <TextBlock Text="{Binding Message}"
                             Foreground="{Binding Brush}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          </Panel>
        </DockPanel>
      </Border>

      <DockPanel Grid.Column="1" Margin="6,0,0,0">

        <!-- Live controller mirror: every control lights up as it is used -->
        <Border DockPanel.Dock="Top" Classes="card" Padding="8" Margin="0,0,0,6">
          <DockPanel>

            <!-- Haptic preview chips: fire a pattern on the mirrored controller -->
            <WrapPanel DockPanel.Dock="Bottom" Margin="4,6,0,0" ItemSpacing="4" LineSpacing="4">
              <WrapPanel.Styles>
                <Style Selector="Button">
                  <Setter Property="FontSize" Value="11" />
                  <Setter Property="Padding" Value="9,3" />
                </Style>
              </WrapPanel.Styles>
              <TextBlock Text="HAPTICS" Classes="label" VerticalAlignment="Center" Margin="0,0,6,0" />
              <Button Content="Working" Command="{Binding PlayPatternCommand}" CommandParameter="working" />
              <Button Content="Approval" Command="{Binding PlayPatternCommand}" CommandParameter="approval" />
              <Button Content="Waiting" Command="{Binding PlayPatternCommand}" CommandParameter="waiting" />
              <Button Content="Completed" Command="{Binding PlayPatternCommand}" CommandParameter="completed" />
              <Button Content="Error" Command="{Binding PlayPatternCommand}" CommandParameter="error" />
              <Button Content="Stop" Classes="deny" Command="{Binding PlayPatternCommand}" CommandParameter="stop" />
            </WrapPanel>

          <StackPanel Spacing="4" DataContext="{Binding ControllerVisual}" x:DataType="gui:ControllerVisualViewModel">
            <TextBlock Text="LIVE INPUT" Classes="label" Margin="4,0,0,2" />
            <!-- Elite Series 2 layout: asymmetric Xbox sticks, hybrid d-pad
                 disc, notched stick rings, guide button, rear paddle blades. -->
            <Viewbox Stretch="Uniform" MaxHeight="230">
              <Canvas Width="420" Height="248">

                <!-- Trigger pull bars -->
                <TextBlock Canvas.Left="84" Canvas.Top="1" Text="LT" FontSize="8" Foreground="#5A7099" />
                <Border Canvas.Left="100" Canvas.Top="0" Width="70" Height="11"
                        CornerRadius="5" Background="#141F36" BorderBrush="#552E4A78" BorderThickness="1">
                  <Border Width="{Binding LeftTriggerWidth}" Height="7" CornerRadius="3"
                          HorizontalAlignment="Left" Margin="1,0,0,0" Background="#00D4FF" />
                </Border>
                <Border Canvas.Left="250" Canvas.Top="0" Width="70" Height="11"
                        CornerRadius="5" Background="#141F36" BorderBrush="#552E4A78" BorderThickness="1">
                  <Border Width="{Binding RightTriggerWidth}" Height="7" CornerRadius="3"
                          HorizontalAlignment="Left" Margin="1,0,0,0" Background="#00D4FF" />
                </Border>
                <TextBlock Canvas.Left="324" Canvas.Top="1" Text="RT" FontSize="8" Foreground="#5A7099" />

                <!-- Bumpers with labels -->
                <Border Canvas.Left="94" Canvas.Top="16" Width="98" Height="15" CornerRadius="8,8,3,3"
                        Background="{Binding LeftShoulderBrush}" RenderTransform="rotate(-3deg)" />
                <Border Canvas.Left="228" Canvas.Top="16" Width="98" Height="15" CornerRadius="8,8,3,3"
                        Background="{Binding RightShoulderBrush}" RenderTransform="rotate(3deg)" />
                <TextBlock Canvas.Left="136" Canvas.Top="18" Text="LB" FontSize="8" Foreground="#8FA9D6" IsHitTestVisible="False" />
                <TextBlock Canvas.Left="272" Canvas.Top="18" Text="RB" FontSize="8" Foreground="#8FA9D6" IsHitTestVisible="False" />

                <!-- Cast shadow grounds the whole controller -->
                <Ellipse Canvas.Left="70" Canvas.Top="176" Width="280" Height="26" Opacity="0.55">
                  <Ellipse.Fill>
                    <RadialGradientBrush>
                      <GradientStop Color="#66000000" Offset="0" />
                      <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>

                <!-- Grips: flared, lit from above like molded plastic -->
                <Ellipse Canvas.Left="38" Canvas.Top="58" Width="96" Height="152"
                         Stroke="#2C3B5E" StrokeThickness="1.5"
                         RenderTransform="rotate(-18deg)">
                  <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="30%,0%" EndPoint="70%,100%">
                      <GradientStop Color="#1E2C49" Offset="0" />
                      <GradientStop Color="#10182A" Offset="0.45" />
                      <GradientStop Color="#080D18" Offset="1" />
                    </LinearGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>
                <Ellipse Canvas.Left="286" Canvas.Top="58" Width="96" Height="152"
                         Stroke="#2C3B5E" StrokeThickness="1.5"
                         RenderTransform="rotate(18deg)">
                  <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="70%,0%" EndPoint="30%,100%">
                      <GradientStop Color="#1E2C49" Offset="0" />
                      <GradientStop Color="#10182A" Offset="0.45" />
                      <GradientStop Color="#080D18" Offset="1" />
                    </LinearGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>

                <!-- Body shell: navy glass with a faint cyan underglow -->
                <Border Canvas.Left="78" Canvas.Top="30" Width="264" Height="120" CornerRadius="46"
                        BorderBrush="#33456B" BorderThickness="1.5"
                        BoxShadow="0 8 26 0 #2200D4FF">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                      <GradientStop Color="#243554" Offset="0" />
                      <GradientStop Color="#16233C" Offset="0.4" />
                      <GradientStop Color="#0C1424" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
                <!-- Top sheen: light catching the shell's curve -->
                <Border Canvas.Left="94" Canvas.Top="34" Width="232" Height="26" CornerRadius="24"
                        IsHitTestVisible="False">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                      <GradientStop Color="#26FFFFFF" Offset="0" />
                      <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>

                <!-- Guide button (nexus): domed with a glow -->
                <Ellipse Canvas.Left="188" Canvas.Top="16" Width="44" Height="44" Fill="#3300D4FF" />
                <Ellipse Canvas.Left="194" Canvas.Top="22" Width="32" Height="32" Stroke="#3D5578" StrokeThickness="1.5">
                  <Ellipse.Fill>
                    <RadialGradientBrush Center="35%,30%" GradientOrigin="35%,30%">
                      <GradientStop Color="#1B2740" Offset="0" />
                      <GradientStop Color="#070C16" Offset="1" />
                    </RadialGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>
                <Ellipse Canvas.Left="200" Canvas.Top="28" Width="20" Height="20" Opacity="0.95">
                  <Ellipse.Fill>
                    <RadialGradientBrush Center="35%,30%" GradientOrigin="35%,30%">
                      <GradientStop Color="#FFFFFF" Offset="0" />
                      <GradientStop Color="#9FD8F2" Offset="1" />
                    </RadialGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>

                <!-- Left stick: high-left, Elite notched ring; the knob and
                     its gloss ride one transform so the shine tracks it -->
                <Ellipse Canvas.Left="118" Canvas.Top="60" Width="58" Height="58"
                         Stroke="#3D5578" StrokeThickness="5" StrokeDashArray="1.2,0.6">
                  <Ellipse.Fill>
                    <RadialGradientBrush>
                      <GradientStop Color="#04070D" Offset="0" />
                      <GradientStop Color="#101B30" Offset="1" />
                    </RadialGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>
                <Ellipse Canvas.Left="133" Canvas.Top="79" Width="30" Height="26" Fill="#66000000" />
                <Canvas Canvas.Left="131" Canvas.Top="73" Width="32" Height="32">
                  <Canvas.RenderTransform>
                    <TranslateTransform X="{Binding LeftStickOffsetX}" Y="{Binding LeftStickOffsetY}" />
                  </Canvas.RenderTransform>
                  <Ellipse Width="32" Height="32"
                           Fill="{Binding LeftThumbBrush}" Stroke="#7DD3FC" StrokeThickness="1" />
                  <Ellipse Canvas.Left="5" Canvas.Top="3" Width="18" Height="11" IsHitTestVisible="False">
                    <Ellipse.Fill>
                      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#59FFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                      </LinearGradientBrush>
                    </Ellipse.Fill>
                  </Ellipse>
                  <Ellipse Canvas.Left="6" Canvas.Top="6" Width="20" Height="20"
                           Stroke="#33000000" StrokeThickness="2" IsHitTestVisible="False" />
                </Canvas>

                <!-- View / Menu / profile switch -->
                <Ellipse Canvas.Left="184" Canvas.Top="82" Width="14" Height="14" Fill="{Binding ViewBrush}" />
                <Ellipse Canvas.Left="222" Canvas.Top="82" Width="14" Height="14" Fill="{Binding MenuBrush}" />
                <Ellipse Canvas.Left="205" Canvas.Top="104" Width="10" Height="10" Fill="#1B2740" Stroke="#33456B" StrokeThickness="1" />

                <!-- Face buttons: recessed wells, glossy caps, Xbox letter colors -->
                <Ellipse Canvas.Left="278" Canvas.Top="51" Width="30" Height="30" Fill="#59000000" />
                <Ellipse Canvas.Left="250" Canvas.Top="78" Width="30" Height="30" Fill="#59000000" />
                <Ellipse Canvas.Left="306" Canvas.Top="78" Width="30" Height="30" Fill="#59000000" />
                <Ellipse Canvas.Left="278" Canvas.Top="105" Width="30" Height="30" Fill="#59000000" />
                <Ellipse Canvas.Left="280" Canvas.Top="52" Width="26" Height="26" Fill="{Binding YBrush}" Stroke="#33456B" StrokeThickness="1" />
                <Ellipse Canvas.Left="252" Canvas.Top="79" Width="26" Height="26" Fill="{Binding XBrush}" Stroke="#33456B" StrokeThickness="1" />
                <Ellipse Canvas.Left="308" Canvas.Top="79" Width="26" Height="26" Fill="{Binding BBrush}" Stroke="#33456B" StrokeThickness="1" />
                <Ellipse Canvas.Left="280" Canvas.Top="106" Width="26" Height="26" Fill="{Binding ABrush}" Stroke="#33456B" StrokeThickness="1" />
                <!-- Gloss caps (never intercept the bound fills underneath) -->
                <Ellipse Canvas.Left="284" Canvas.Top="54" Width="18" Height="9" Fill="#40FFFFFF" IsHitTestVisible="False" />
                <Ellipse Canvas.Left="256" Canvas.Top="81" Width="18" Height="9" Fill="#40FFFFFF" IsHitTestVisible="False" />
                <Ellipse Canvas.Left="312" Canvas.Top="81" Width="18" Height="9" Fill="#40FFFFFF" IsHitTestVisible="False" />
                <Ellipse Canvas.Left="284" Canvas.Top="108" Width="18" Height="9" Fill="#40FFFFFF" IsHitTestVisible="False" />
                <TextBlock Canvas.Left="288" Canvas.Top="56" Text="{Binding NorthLabel}" FontSize="12" FontWeight="Bold" Foreground="#E8C531" />
                <TextBlock Canvas.Left="260" Canvas.Top="83" Text="{Binding WestLabel}" FontSize="12" FontWeight="Bold" Foreground="#4C8DF5" />
                <TextBlock Canvas.Left="316" Canvas.Top="83" Text="{Binding EastLabel}" FontSize="12" FontWeight="Bold" Foreground="#E85555" />
                <TextBlock Canvas.Left="288" Canvas.Top="110" Text="{Binding SouthLabel}" FontSize="12" FontWeight="Bold" Foreground="#6EBE45" />

                <!-- Hybrid d-pad: dished disc with a domed pivot -->
                <Ellipse Canvas.Left="136" Canvas.Top="120" Width="54" Height="54" Stroke="#33456B" StrokeThickness="1.5">
                  <Ellipse.Fill>
                    <RadialGradientBrush>
                      <GradientStop Color="#05080F" Offset="0" />
                      <GradientStop Color="#141F36" Offset="1" />
                    </RadialGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>
                <Border Canvas.Left="155" Canvas.Top="126" Width="16" Height="14" CornerRadius="3" Background="{Binding DPadUpBrush}" />
                <Border Canvas.Left="155" Canvas.Top="154" Width="16" Height="14" CornerRadius="3" Background="{Binding DPadDownBrush}" />
                <Border Canvas.Left="141" Canvas.Top="140" Width="14" Height="14" CornerRadius="3" Background="{Binding DPadLeftBrush}" />
                <Border Canvas.Left="171" Canvas.Top="140" Width="14" Height="14" CornerRadius="3" Background="{Binding DPadRightBrush}" />
                <Border Canvas.Left="155" Canvas.Top="140" Width="16" Height="14" Background="#131B2C" />
                <Ellipse Canvas.Left="158" Canvas.Top="142" Width="10" Height="10" IsHitTestVisible="False">
                  <Ellipse.Fill>
                    <RadialGradientBrush Center="35%,30%" GradientOrigin="35%,30%">
                      <GradientStop Color="#2E4064" Offset="0" />
                      <GradientStop Color="#10192B" Offset="1" />
                    </RadialGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>

                <!-- Right stick: low-center-right, notched ring -->
                <Ellipse Canvas.Left="226" Canvas.Top="118" Width="58" Height="58"
                         Stroke="#3D5578" StrokeThickness="5" StrokeDashArray="1.2,0.6">
                  <Ellipse.Fill>
                    <RadialGradientBrush>
                      <GradientStop Color="#04070D" Offset="0" />
                      <GradientStop Color="#101B30" Offset="1" />
                    </RadialGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>
                <Ellipse Canvas.Left="241" Canvas.Top="137" Width="30" Height="26" Fill="#66000000" />
                <Canvas Canvas.Left="239" Canvas.Top="131" Width="32" Height="32">
                  <Canvas.RenderTransform>
                    <TranslateTransform X="{Binding RightStickOffsetX}" Y="{Binding RightStickOffsetY}" />
                  </Canvas.RenderTransform>
                  <Ellipse Width="32" Height="32"
                           Fill="{Binding RightThumbBrush}" Stroke="#7DD3FC" StrokeThickness="1" />
                  <Ellipse Canvas.Left="5" Canvas.Top="3" Width="18" Height="11" IsHitTestVisible="False">
                    <Ellipse.Fill>
                      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#59FFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                      </LinearGradientBrush>
                    </Ellipse.Fill>
                  </Ellipse>
                  <Ellipse Canvas.Left="6" Canvas.Top="6" Width="20" Height="20"
                           Stroke="#33000000" StrokeThickness="2" IsHitTestVisible="False" />
                </Canvas>

                <!-- Rear paddles: metal-edged blade pairs as on the real back -->
                <Border Canvas.Left="158" Canvas.Top="196" Width="13" Height="42" CornerRadius="6"
                        Background="{Binding PaddleLeft1Brush}" BorderBrush="#3D5578" BorderThickness="1"
                        BoxShadow="0 3 6 0 #66000000" />
                <Border Canvas.Left="177" Canvas.Top="200" Width="13" Height="32" CornerRadius="6"
                        Background="{Binding PaddleLeft2Brush}" BorderBrush="#3D5578" BorderThickness="1"
                        BoxShadow="0 3 6 0 #66000000" />
                <Border Canvas.Left="230" Canvas.Top="200" Width="13" Height="32" CornerRadius="6"
                        Background="{Binding PaddleRight2Brush}" BorderBrush="#3D5578" BorderThickness="1"
                        BoxShadow="0 3 6 0 #66000000" />
                <Border Canvas.Left="249" Canvas.Top="196" Width="13" Height="42" CornerRadius="6"
                        Background="{Binding PaddleRight1Brush}" BorderBrush="#3D5578" BorderThickness="1"
                        BoxShadow="0 3 6 0 #66000000" />
                <TextBlock Canvas.Left="157" Canvas.Top="238" Text="P1" FontSize="8" Foreground="#5A7099" />
                <TextBlock Canvas.Left="176" Canvas.Top="238" Text="P2" FontSize="8" Foreground="#5A7099" />
                <TextBlock Canvas.Left="229" Canvas.Top="238" Text="P4" FontSize="8" Foreground="#5A7099" />
                <TextBlock Canvas.Left="248" Canvas.Top="238" Text="P3" FontSize="8" Foreground="#5A7099" />
                <TextBlock Canvas.Left="196" Canvas.Top="214" Text="REAR" FontSize="7" LetterSpacing="2" Foreground="#3D5578" />

              </Canvas>
            </Viewbox>
          </StackPanel>
          </DockPanel>
        </Border>

        <Border Classes="card" Padding="8">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="ACTIVE BINDINGS" Classes="label" Margin="4,0,0,6" />
            <Panel>
            <TextBlock Classes="placeholder"
                       Text="No bindings — open Profile… to add some."
                       IsVisible="{Binding IsBindingsEmpty}" />
            <ListBox ItemsSource="{Binding Bindings}" FontSize="12">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="6,3" />
                  <Setter Property="MinHeight" Value="0" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="gui:BindingRow">
                  <DockPanel>
                    <Border DockPanel.Dock="Left"
                            Background="#141F36"
                            BorderBrush="#552E4A78"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,1"
                            MinWidth="88"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding Chord}"
                                 FontFamily="Cascadia Mono,Consolas,monospace"
                                 FontSize="11"
                                 Foreground="#7DD3FC"
                                 HorizontalAlignment="Center" />
                    </Border>
                    <Border DockPanel.Dock="Right"
                            Background="#33FFB020"
                            CornerRadius="4"
                            Padding="5,1"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsApproval}">
                      <TextBlock Text="approval" FontSize="9" Foreground="#FFD9A0" />
                    </Border>
                    <TextBlock Text="{Binding Action}"
                               Margin="8,0"
                               VerticalAlignment="Center"
                               Foreground="#B9CCEF" />
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            </Panel>
          </DockPanel>
        </Border>
      </DockPanel>
    </Grid>

  </DockPanel>

  <!-- Approval banner: floats over the content instead of reflowing it -->
  <Border Classes="alert approvalBanner"
          Classes.show="{Binding HasPendingApproval}"
          VerticalAlignment="Top"
          HorizontalAlignment="Center"
          Margin="16,218,16,0"
          Padding="14,10"
          BoxShadow="0 6 28 0 #66FFB020"
          IsVisible="{Binding HasPendingApproval}">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <TextBlock Text="APPROVAL REQUIRED"
                 Classes="label"
                 Foreground="#FFD9A0"
                 Opacity="1"
                 VerticalAlignment="Center" />
      <TextBlock Text="{Binding PendingApprovalMessage}"
                 VerticalAlignment="Center"
                 TextWrapping="Wrap"
                 MaxWidth="330"
                 Foreground="#FFEFD6" />
      <Button Content="Approve once" Classes="approve" Command="{Binding ApproveOnceCommand}" />
      <Button Content="Approve for session" Classes="approve" Command="{Binding ApproveSessionCommand}" />
      <Button Content="Decline" Classes="deny" Command="{Binding DeclineCommand}" />
      <Button Content="Cancel" Classes="deny" Command="{Binding CancelCommand}" />
    </StackPanel>
  </Border>

  <!-- First-run setup overlay -->
  <Border IsVisible="{Binding IsSetupVisible}" Background="#E0060B14">
    <Border Classes="card" MaxWidth="480" Padding="26" VerticalAlignment="Center" HorizontalAlignment="Center">
      <StackPanel Spacing="12">
        <TextBlock Text="WELCOME TO CTRLAGENT" Classes="label" FontSize="12" HorizontalAlignment="Center" />
        <TextBlock Text="One-time setup: pick the agent to drive and the repository to work in. Saved for next launch — command-line flags always override."
                   FontSize="12"
                   Foreground="#9FB7DF"
                   TextWrapping="Wrap" />
        <TextBlock Text="Agent platform" FontSize="11" Opacity="0.6" />
        <ComboBox ItemsSource="{x:Static gui:MainViewModel.SetupAgents}"
                  SelectedItem="{Binding SetupAgent}"
                  HorizontalAlignment="Stretch" />
        <TextBlock Text="Working directory (your repository)" FontSize="11" Opacity="0.6" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Click="OnBrowseWorkingDirectory" />
          <TextBox Text="{Binding SetupWorkingDirectory}" />
        </DockPanel>
        <TextBlock Text="{Binding SetupError}"
                   Foreground="#FF7A6E"
                   FontSize="12"
                   TextWrapping="Wrap"
                   IsVisible="{Binding SetupError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Button Content="Start"
                Classes="accent"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Command="{Binding StartSetupCommand}" />
        <TextBlock Text="mock is the safe demo agent (no real AI calls). codex and claude need their CLI installed and authenticated."
                   FontSize="11"
                   Opacity="0.5"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Border>
  </Panel>
</Window>
