<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gui="using:CtrlAgent.Gui"
        x:Class="CtrlAgent.Gui.MainWindow"
        x:DataType="gui:MainViewModel"
        Title="{Binding WindowTitle}"
        Icon="avares://CtrlAgent.Gui/Assets/icon.png"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        Width="980"
        Height="840"
        MinWidth="740"
        MinHeight="660">

  <Window.Styles>
    <!-- First-run card: rises and settles once, so the app opens rather than
         blinks into existence. Base state is set in markup because Avalonia
         renders an element's own value during Animation.Delay. -->
    <Style Selector="Border.setupCard">
      <Style.Animations>
        <Animation Duration="0:0:0.65" Delay="0:0:0.1" IterationCount="1"
                   FillMode="Forward" Easing="CubicEaseOut">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="22" />
            <Setter Property="ScaleTransform.ScaleX" Value="0.97" />
            <Setter Property="ScaleTransform.ScaleY" Value="0.97" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>

  <Panel>
  <gui:AmbientBackdrop />

  <!-- Client area extends into the title bar; leave room for caption buttons -->
  <DockPanel Margin="26,40,26,22">

    <!-- ===================== COMMAND BAR =====================
         Hero and status used to be two stacked cards with a wordmark in the
         middle of the first one. The wordmark was the widest thing on screen
         and told you nothing you did not already know — you are looking at the
         app. Dropping it and merging the two cards gives ~90px back to the
         conversation, which is the part you actually read.

         One surface, two rows: who you are talking to, then what you can
         change about it. Still the window drag handle. -->
    <Border DockPanel.Dock="Top"
            Name="HeroBand"
            PointerPressed="OnHeroPressed"
            Classes="card"
            CornerRadius="18"
            Padding="20,12"
            Margin="0,0,0,12">
      <StackPanel Spacing="9">

        <!-- Row 1 — what the session is, and the window-level tools. CTRL·BOT
             moved out of here into the controller hub on the right: the bot,
             the pad, and the shortcuts are one subject and belong in one
             place, and the command bar gets calmer for it. -->
        <DockPanel>
          <Border DockPanel.Dock="Right"
                  VerticalAlignment="Center"
                  Background="#4D0E1728"
                  BorderBrush="#1FFFFFFF"
                  BorderThickness="1"
                  CornerRadius="13"
                  Padding="4,3">
            <StackPanel Orientation="Horizontal" Spacing="1">
              <!-- Stroked Path icons, never text glyphs: the app ships Inter,
                   which has none of the dingbats these buttons used, and the
                   Windows fallback drew them as blobs and boxes. -->
              <Button Classes="tool" Command="{Binding NewSessionCommand}"
                      ToolTip.Tip="Start a fresh session (Menu on the controller)">
                <Path Classes="icon" Width="14" Height="14"
                      Data="M9,3.5 V14.5 M3.5,9 H14.5" />
              </Button>
              <Rectangle Width="1" Fill="#14FFFFFF" Margin="3,5" />
              <Button Classes="tool" Click="OnShowMainframe"
                      ToolTip.Tip="Mainframe — fullscreen controller-first mode (F11, Xbox/PS button, or double-press View)">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Path Classes="icon" Width="14" Height="14"
                        Data="M3,6.5 V3 H6.5 M11.5,3 H15 V6.5 M15,11.5 V15 H11.5 M6.5,15 H3 V11.5" />
                  <TextBlock Text="Mainframe" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Rectangle Width="1" Fill="#14FFFFFF" Margin="3,5" />
              <Button Classes="tool" Click="OnToggleOverlay" ToolTip.Tip="Toggle the always-on-top HUD">
                <Path Classes="icon" Width="14" Height="14"
                      Data="M9,3 L15,6.5 L9,10 L3,6.5 Z M4,10.5 L9,13.5 L14,10.5" />
              </Button>
              <!-- Mic picker: which device dictation listens on. A setup
                   concern, so it lives in the rail — in-app because
                   System.Speech only follows the Windows default otherwise,
                   and "change your OS sound settings" is not a feature. -->
              <Button x:Name="MicPickButton"
                      Classes="tool"
                      Click="OnPickMicrophone"
                      ToolTip.Tip="Choose which microphone dictation uses">
                <Path Classes="icon" Width="14" Height="14"
                      Data="M9,2.5 A2.6,2.6 0 0 1 11.6,5.1 L11.6,9.4 A2.6,2.6 0 0 1 6.4,9.4
                            L6.4,5.1 A2.6,2.6 0 0 1 9,2.5 Z
                            M4.2,9.2 A4.8,4.8 0 0 0 13.8,9.2
                            M9,14 L9,16.2 M6.4,16.2 L11.6,16.2" />
                <FlyoutBase.AttachedFlyout>
                  <MenuFlyout ItemsSource="{Binding Microphones}">
                    <MenuFlyout.ItemContainerTheme>
                      <ControlTheme TargetType="MenuItem"
                                    BasedOn="{StaticResource {x:Type MenuItem}}"
                                    x:DataType="gui:MicrophoneChoice">
                        <Setter Property="Header" Value="{Binding Label}" />
                        <Setter Property="Command" Value="{Binding SelectCommand}" />
                      </ControlTheme>
                    </MenuFlyout.ItemContainerTheme>
                  </MenuFlyout>
                </FlyoutBase.AttachedFlyout>
              </Button>
              <Button Classes="tool" Click="OnEditProfile"
                      ToolTip.Tip="Edit controller bindings with live validation">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Path Classes="icon" Width="14" Height="14"
                        Data="M9,5.6 A3.4,3.4 0 1 1 8.99,5.6 M9,2.4 V4.4 M9,13.6 V15.6 M2.4,9 H4.4 M13.6,9 H15.6 M4.3,4.3 L5.7,5.7 M12.3,12.3 L13.7,13.7 M13.7,4.3 L12.3,5.7 M5.7,12.3 L4.3,13.7" />
                  <TextBlock Text="{Binding ProfileName}" VerticalAlignment="Center" />
                  <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{Binding ProfileDotBrush}" />
                </StackPanel>
              </Button>
              <Button Classes="tool" Click="OnValidateHardware" ToolTip.Tip="Run the guided hardware validation wizard">
                <Path Classes="icon" Width="14" Height="14"
                      Data="M9,3.4 A5.6,5.6 0 1 1 8.99,3.4 M9,6.6 A2.4,2.4 0 1 1 8.99,6.6" />
              </Button>
            </StackPanel>
          </Border>

          <WrapPanel ItemSpacing="12" LineSpacing="8" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
              <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                       Fill="{Binding AgentDotBrush}" Classes.pulse="{Binding IsAgentActive}" />
              <StackPanel Spacing="1">
                <TextBlock Text="AGENT" Classes="label" FontSize="9" />
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <TextBlock Text="{Binding AgentStatus}" FontSize="13" FontWeight="Medium" Foreground="#E6EFFB" />
                  <TextBlock Text="{Binding AgentState}" FontSize="13" Foreground="#7DD3FC" />
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <Rectangle Width="1" Height="28" Fill="#14FFFFFF" VerticalAlignment="Center" />

            <Button Classes="ghost" Padding="8,4" Command="{Binding PickWorkspaceCommand}"
                    VerticalAlignment="Center" Cursor="Hand" ToolTip.Tip="{Binding WorkspacePath}">
              <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Path Classes="icon" Width="13" Height="13" Stroke="#6B84AD"
                      Data="M2.5,14.5 V4.5 H7 L8.6,6.4 H15.5 V14.5 Z" />
                <StackPanel Spacing="1">
                  <TextBlock Text="WORKSPACE" Classes="label" FontSize="9" />
                  <TextBlock Text="{Binding WorkspaceName}" FontSize="13" FontWeight="Medium"
                             Foreground="#E6EFFB" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                </StackPanel>
              </StackPanel>
            </Button>

            <Rectangle Width="1" Height="28" Fill="#14FFFFFF" VerticalAlignment="Center" />

            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
              <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                       Fill="{Binding ControllerDotBrush}" Classes.pulse="{Binding IsControllerSearching}" />
              <StackPanel Spacing="1">
                <TextBlock Text="CONTROLLER" Classes="label" FontSize="9" />
                <TextBlock Text="{Binding ControllerStatus}" FontSize="13" FontWeight="Medium"
                           Foreground="#E6EFFB" TextTrimming="CharacterEllipsis" MaxWidth="205" />
              </StackPanel>
            </StackPanel>

          </WrapPanel>
        </DockPanel>

        <Rectangle Height="1" Fill="#14FFFFFF" />

        <!-- Row 2 — the session knobs, on their own quiet line -->
        <DockPanel LastChildFill="False">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"
                      VerticalAlignment="Center">
            <Button Content="{Binding PermissionModeLabel}" Command="{Binding CyclePermissionModeCommand}"
                    Classes="knob"
                    ToolTip.Tip="Cycle the agent's permission mode: default, plan, acceptEdits, auto, dontAsk" />
            <!-- A picker, not a blind cycle: clicking shows the choices like
                 the Claude app's model menu. The controller's CycleModel
                 binding still steps the same setting — both paths meet in
                 HostEngine.Settings, so the label follows either. -->
            <Button Name="ModelKnob"
                    Content="{Binding ModelLabel}"
                    Classes="knob"
                    ToolTip.Tip="Choose the model for this session">
              <Button.Flyout>
                <MenuFlyout Placement="Bottom">
                  <MenuItem Header="default — let Claude Code choose"
                            Command="{Binding SelectModelCommand}" CommandParameter="default" />
                  <MenuItem Header="opus — most capable"
                            Command="{Binding SelectModelCommand}" CommandParameter="opus" />
                  <MenuItem Header="sonnet — balanced"
                            Command="{Binding SelectModelCommand}" CommandParameter="sonnet" />
                  <MenuItem Header="haiku — fastest"
                            Command="{Binding SelectModelCommand}" CommandParameter="haiku" />
                  <MenuItem Header="fable — frontier"
                            Command="{Binding SelectModelCommand}" CommandParameter="fable" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button Content="{Binding EffortLabel}" Command="{Binding CycleEffortCommand}"
                    Classes="knob" ToolTip.Tip="Cycle reasoning effort: low, medium, high, xhigh, max" />
            <Button Content="compact" Command="{Binding CompactCommand}"
                    Classes="knob" ToolTip.Tip="Compact the conversation, freeing context" />
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- Mission control's two columns: Mainframe CTA + events, controller hub -->
    <Grid ColumnDefinitions="3*,2*" Margin="0,14,0,10">

      <!-- Column 0: the Mainframe call-to-action on top, the event stream
           underneath. This window is mission control — set up, verify, then
           go where the work happens. Coding lives in Mainframe only (owner's
           call); nothing here submits prompts or answers approvals. -->
      <Grid RowDefinitions="Auto,*" Margin="0,0,9,0">

        <Border Classes="card" Padding="18,16">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="accent" FontSize="14" Padding="20,12"
                    VerticalAlignment="Center" Click="OnShowMainframe">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <Path Classes="icon" Width="15" Height="15"
                      Data="M3,6.5 V3 H6.5 M11.5,3 H15 V6.5 M15,11.5 V15 H11.5 M6.5,15 H3 V11.5" />
                <TextBlock Text="Enter Mainframe" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <StackPanel Spacing="4" VerticalAlignment="Center" Margin="0,0,14,0">
              <TextBlock Text="MAINFRAME" Classes="label" />
              <TextBlock Text="The coding surface: chat, voice, diff review, approvals — fullscreen and controller-first."
                         FontSize="12.5" Foreground="#9FB7DF" TextWrapping="Wrap" />
              <TextBlock Text="F11 · Xbox/PS button · double-press View"
                         FontSize="11" Foreground="#5A7099"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- The diagnostics stream: what the engine, controller, and agent
             are doing, severity-tinted. This window watches the machinery;
             the conversation lives in Mainframe. -->
        <Border Grid.Row="1" Classes="card" Padding="16,14" Margin="0,12,0,0">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="4,0,0,6">
              <ToggleButton DockPanel.Dock="Right" Classes="chip"
                            Content="controller input"
                            IsChecked="{Binding ShowControllerEvents}"
                            ToolTip.Tip="Show or hide raw controller input lines" />
              <TextBlock Text="EVENTS" Classes="label" VerticalAlignment="Center" />
            </DockPanel>
            <Panel>
              <TextBlock Classes="placeholder"
                         Text="No events yet — controller and agent activity will stream here."
                         IsVisible="{Binding IsLogEmpty}" />
              <ListBox x:Name="EventStream"
                       ItemsSource="{Binding Log}"
                       FontFamily="Cascadia Mono,Consolas,monospace"
                       FontSize="12">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="6,2" />
                    <Setter Property="MinHeight" Value="0" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="gui:LogEntry">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Timestamp}" Foreground="#5A7099" />
                      <TextBlock Text="{Binding Message}"
                                 Foreground="{Binding Brush}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Panel>
          </DockPanel>
        </Border>
      </Grid>

      <!-- ===================== CONTROLLER HUB =====================
           One card, one subject: the companion that coaches the pad, the pad
           itself, and everything it can do right now. These lived in three
           places (bot in the command bar, mirror and bindings in separate
           cards), which meant looking around the app to answer the single
           question "what can my controller do". Fixed rows for the bot and
           mirror, star row for the shortcuts — the list absorbs short
           windows instead of the mirror eating the column. -->
      <Grid Grid.Column="1" Margin="9,0,0,0">
        <Border Classes="card" Padding="16,14">
          <Grid RowDefinitions="Auto,Auto,Auto,*">

            <!-- CTRL·BOT and the line it is currently coaching. DockPanel so
                 the bubble fills what remains and can never overflow the
                 card edge on a narrow window. -->
            <DockPanel Grid.Row="0" Margin="4,0,0,4"
                       DataContext="{Binding Buddy}"
                       x:DataType="gui:AgentBuddyViewModel">
              <Viewbox DockPanel.Dock="Left" Height="56" Stretch="Uniform" Margin="0,0,10,0">
                <gui:BotView />
              </Viewbox>
              <Border Background="#7A17243E"
                      BorderBrush="#14FFFFFF"
                      BorderThickness="1"
                      CornerRadius="12"
                      Padding="12,7"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center">
                <TextBlock Text="{Binding Message}"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="#CFE1FF" />
              </Border>
            </DockPanel>

            <!-- Live input: every control lights up as it is used. Elite
                 Series 2 layout: asymmetric sticks, hybrid d-pad disc,
                 notched stick rings, guide button, rear paddle blades. -->
            <gui:ControllerMirrorView Grid.Row="1"
                                      MaxHeight="112"
                                      Margin="0,6,0,0"
                                      DataContext="{Binding ControllerVisual}" />

            <!-- Six haptic-preview chips used to sit here and wrapped into a
                 five-row stack on a narrow window, shoving the shortcuts
                 below the fold. Testing rumble is an occasional act; it fits
                 in one flyout. -->
            <StackPanel Grid.Row="2" Spacing="5" Margin="0,7,0,4">
              <Rectangle Height="1" Fill="#14FFFFFF" />
              <DockPanel Margin="4,4,0,0">
                <Button DockPanel.Dock="Right"
                        Classes="ghost"
                        FontSize="11"
                        Padding="8,2"
                        Content="haptics"
                        ToolTip.Tip="Play a haptic pattern on the connected controller">
                  <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                      <MenuItem Header="Working" Command="{Binding PlayPatternCommand}" CommandParameter="working" />
                      <MenuItem Header="Approval" Command="{Binding PlayPatternCommand}" CommandParameter="approval" />
                      <MenuItem Header="Waiting" Command="{Binding PlayPatternCommand}" CommandParameter="waiting" />
                      <MenuItem Header="Completed" Command="{Binding PlayPatternCommand}" CommandParameter="completed" />
                      <MenuItem Header="Error" Command="{Binding PlayPatternCommand}" CommandParameter="error" />
                      <MenuItem Header="Stop" Command="{Binding PlayPatternCommand}" CommandParameter="stop" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
                <Button DockPanel.Dock="Right"
                        Classes="ghost"
                        FontSize="11"
                        Padding="8,2"
                        Margin="0,0,6,0"
                        Content="view all"
                        ToolTip.Tip="Every binding at full size (F1)"
                        Command="{Binding ShowShortcutsCommand}" />
                <TextBlock Text="{Binding ShortcutsHeading}" Classes="label" VerticalAlignment="Center" />
              </DockPanel>
            </StackPanel>

            <Panel Grid.Row="3">
            <TextBlock Classes="placeholder"
                       Text="No bindings — open Profile… to add some."
                       IsVisible="{Binding IsBindingsEmpty}" />
            <!-- The same chip language as Mainframe's HUD: face buttons as
                 their colored circles (Sony shapes on a DualSense), the d-pad
                 as the drawn cross, keycap text for the rest. Two surfaces
                 describing one pad must describe it the same way. -->
            <ListBox ItemsSource="{Binding VisibleBindings}" FontSize="12">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="6,1.5" />
                  <Setter Property="MinHeight" Value="0" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="gui:BindingRow">
                  <DockPanel>
                    <Border DockPanel.Dock="Left"
                            Background="#4D0E1728"
                            BorderBrush="#1FFFFFFF"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="6,2"
                            MinWidth="60"
                            VerticalAlignment="Center">
                      <ItemsControl ItemsSource="{Binding Tokens}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2.5" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="gui:ChordToken">
                            <Panel VerticalAlignment="Center">
                              <TextBlock Text="{Binding Text}"
                                         FontFamily="Cascadia Mono,Consolas,monospace"
                                         FontSize="10.5"
                                         Foreground="#7DD3FC"
                                         VerticalAlignment="Center"
                                         IsVisible="{Binding IsText}" />
                              <Border Width="17" Height="17" CornerRadius="8.5"
                                      Background="#0B1322"
                                      BorderThickness="1.3"
                                      BorderBrush="{Binding FaceBrush}"
                                      IsVisible="{Binding IsFace}">
                                <Panel>
                                  <TextBlock Text="{Binding Text}"
                                             FontSize="9"
                                             FontWeight="Bold"
                                             Foreground="{Binding FaceBrush}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             IsVisible="{Binding IsLetter}" />
                                  <Path Data="{Binding ShapeData}"
                                        Stroke="{Binding FaceBrush}"
                                        StrokeThickness="1.3"
                                        Width="8.5" Height="8.5"
                                        Stretch="Uniform"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding IsShape}" />
                                </Panel>
                              </Border>
                              <gui:DPadIcon Width="15" Height="15"
                                            Direction="{Binding Control}"
                                            IsVisible="{Binding IsDPad}" />
                            </Panel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                    <Border DockPanel.Dock="Right"
                            Background="#33FFB020"
                            CornerRadius="4"
                            Padding="5,1"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsApproval}">
                      <TextBlock Text="approval" FontSize="9" Foreground="#FFD9A0" />
                    </Border>
                    <TextBlock Text="{Binding Action}"
                               Margin="8,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="#B9CCEF" />
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            </Panel>
          </Grid>
        </Border>
      </Grid>
    </Grid>

  </DockPanel>

  <!-- ===================== ALL SHORTCUTS =====================
       The complete controller map at desktop scale (F1, Esc closes). The
       main window is mouse-and-keyboard-first, so the inline hub keeps a
       compact reference and this overlay is where "show me everything"
       lives — every binding visible at once, full height, no scrolling
       squeezed into a sidebar. -->
  <Border IsVisible="{Binding IsShortcutsVisible}" Background="#CC05080F">
    <Border Classes="card"
            Background="#F70B1424"
            MaxWidth="640"
            Margin="0,36"
            Padding="24,16"
            HorizontalAlignment="Center">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="4,0,0,12">
          <Button DockPanel.Dock="Right" Classes="tool" Command="{Binding CloseShortcutsCommand}"
                  ToolTip.Tip="Close (Esc)">
            <Path Classes="icon" Width="12" Height="12"
                  Data="M4.5,4.5 L13.5,13.5 M13.5,4.5 L4.5,13.5" />
          </Button>
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="CONTROLLER SHORTCUTS" Classes="label" VerticalAlignment="Center" />
            <TextBlock Text="approval-tagged inputs only fire while the agent is asking"
                       FontSize="11.5" Foreground="#5A7099" VerticalAlignment="Center" />
          </StackPanel>
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Bindings}" Margin="4,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="gui:BindingRow">
                <DockPanel Margin="0,1.5">
                  <Border DockPanel.Dock="Left"
                          Background="#4D0E1728"
                          BorderBrush="#1FFFFFFF"
                          BorderThickness="1"
                          CornerRadius="7"
                          Padding="8,2"
                          MinWidth="118"
                          VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding Tokens}" HorizontalAlignment="Center">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="3" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="gui:ChordToken">
                          <Panel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Text}"
                                       FontFamily="Cascadia Mono,Consolas,monospace"
                                       FontSize="13"
                                       Foreground="#7DD3FC"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding IsText}" />
                            <Border Width="21" Height="21" CornerRadius="10.5"
                                    Background="#0B1322"
                                    BorderThickness="1.6"
                                    BorderBrush="{Binding FaceBrush}"
                                    IsVisible="{Binding IsFace}">
                              <Panel>
                                <TextBlock Text="{Binding Text}"
                                           FontSize="11.5"
                                           FontWeight="Bold"
                                           Foreground="{Binding FaceBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding IsLetter}" />
                                <Path Data="{Binding ShapeData}"
                                      Stroke="{Binding FaceBrush}"
                                      StrokeThickness="1.5"
                                      Width="11" Height="11"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsVisible="{Binding IsShape}" />
                              </Panel>
                            </Border>
                            <gui:DPadIcon Width="18" Height="18"
                                          Direction="{Binding Control}"
                                          IsVisible="{Binding IsDPad}" />
                          </Panel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                  <Border DockPanel.Dock="Right"
                          Background="#33FFB020"
                          CornerRadius="5"
                          Padding="7,2"
                          VerticalAlignment="Center"
                          IsVisible="{Binding IsApproval}">
                    <TextBlock Text="approval" FontSize="10" Foreground="#FFD9A0" />
                  </Border>
                  <TextBlock Text="{Binding Action}"
                             Margin="12,0"
                             FontSize="14"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"
                             Foreground="#D7E4FA" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Border>

  <!-- Startup failure. Same treatment as first-run: a dead app is a screen in
       its own right, not a modal over a greyed-out UI that is not running.
       Showing the disabled app behind it invited people to poke at controls
       that do nothing. -->
  <Border IsVisible="{Binding HasStartupError}" Background="#05080F">
    <Panel>
      <gui:AmbientBackdrop />

      <Border Classes="card setupCard"
              Opacity="0"
              MaxWidth="560"
              Padding="40,34"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Background="#26150E14"
              BorderBrush="#66FF5A78"
              RenderTransformOrigin="50%,50%">
        <StackPanel Spacing="18">
          <StackPanel Spacing="10">
            <Image Source="avares://CtrlAgent.Gui/Assets/logo.png"
                   Height="56"
                   Opacity="0.5"
                   HorizontalAlignment="Center"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Text="COULDN'T START"
                       Classes="label"
                       FontSize="11"
                       LetterSpacing="3"
                       Foreground="#FF9AA8"
                       TextAlignment="Center"
                       HorizontalAlignment="Center" />
          </StackPanel>

          <Rectangle Height="1" Fill="#33FF5A78" />

          <TextBlock Text="{Binding StartupError}"
                     FontSize="14"
                     Foreground="#FFD9DF"
                     TextWrapping="Wrap"
                     TextAlignment="Center" />

          <TextBlock Text="Nothing is connected and no bindings are active until this is resolved. If you passed command-line flags, check that any path containing spaces is quoted."
                     FontSize="12"
                     Foreground="#9FB7DF"
                     TextWrapping="Wrap"
                     TextAlignment="Center" />

          <Button Content="Change settings…"
                  Classes="accent"
                  FontSize="14"
                  Padding="14,10"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Command="{Binding DismissStartupErrorCommand}" />
        </StackPanel>
      </Border>
    </Panel>
  </Border>

  <!-- First-run setup: the very first thing anyone sees. It used to be a
       plain card over a dimmed screenshot of an app you had not started yet,
       with the wordmark greyed out behind the scrim — the one moment the
       product introduces itself, spent showing a disabled UI. Now it is its
       own screen: opaque, on the shared field, brand first. -->
  <Border IsVisible="{Binding IsSetupVisible}" Background="#05080F">
    <Panel>
      <gui:AmbientBackdrop />

      <Border Classes="card setupCard" Opacity="0" MaxWidth="520" Padding="40,34"
              VerticalAlignment="Center" HorizontalAlignment="Center"
              RenderTransformOrigin="50%,50%">
        <StackPanel Spacing="18">

          <StackPanel Spacing="10">
            <Image Source="avares://CtrlAgent.Gui/Assets/logo.png"
                   Height="72"
                   HorizontalAlignment="Center"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Text="CONTROLLER INTERFACE FOR AI CODING AGENTS"
                       Classes="label"
                       FontSize="9"
                       LetterSpacing="2.6"
                       TextAlignment="Center"
                       HorizontalAlignment="Center" />
          </StackPanel>

          <Rectangle Height="1" Fill="#14FFFFFF" />

          <TextBlock Text="Pick the agent to drive and the repository to work in. Saved for next launch — command-line flags always override."
                     FontSize="12.5"
                     Foreground="#9FB7DF"
                     TextWrapping="Wrap"
                     TextAlignment="Center" />

          <StackPanel Spacing="6">
            <TextBlock Text="AGENT PLATFORM" Classes="label" FontSize="9" />
            <ComboBox ItemsSource="{x:Static gui:MainViewModel.SetupAgents}"
                      SelectedItem="{Binding SetupAgent}"
                      HorizontalAlignment="Stretch" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="WORKING DIRECTORY" Classes="label" FontSize="9" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="OnBrowseWorkingDirectory" />
              <TextBox Text="{Binding SetupWorkingDirectory}" />
            </DockPanel>
          </StackPanel>

          <TextBlock Text="{Binding SetupError}"
                     Foreground="#FF7A6E"
                     FontSize="12"
                     TextWrapping="Wrap"
                     IsVisible="{Binding SetupError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <Button Content="Start"
                  Classes="accent"
                  FontSize="14"
                  Padding="14,10"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Command="{Binding StartSetupCommand}" />

          <TextBlock Text="mock is the safe demo agent — no real AI calls. codex and claude need their CLI installed and authenticated."
                     FontSize="11"
                     Foreground="#5A7099"
                     TextWrapping="Wrap"
                     TextAlignment="Center" />
        </StackPanel>
      </Border>
    </Panel>
  </Border>
  </Panel>
</Window>
