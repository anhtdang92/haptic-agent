<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gui="using:CtrlAgent.Gui"
        x:Class="CtrlAgent.Gui.MainWindow"
        x:DataType="gui:MainViewModel"
        Title="CtrlAgent"
        Icon="avares://CtrlAgent.Gui/Assets/icon.png"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        Width="980"
        Height="760"
        MinWidth="740"
        MinHeight="660">

  <Window.Styles>
    <!-- Conversation view: prose as chat bubbles, tool/status lines as
         small dim activity rows — the Claude-app layout -->
    <Style Selector="ListBox.chat ListBoxItem">
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.bubble">
      <Setter Property="Background" Value="#CC17233C" />
      <Setter Property="BorderBrush" Value="#1FFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="MaxWidth" Value="400" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.bubble.user">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Background" Value="#33194B66" />
      <Setter Property="BorderBrush" Value="#5900D4FF" />
    </Style>
    <Style Selector="TextBlock.activityRow">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#7B93BC" />
      <Setter Property="Margin" Value="2,0" />
    </Style>
  </Window.Styles>

  <Panel>
  <gui:AmbientBackdrop />

  <!-- Client area extends into the title bar; leave room for caption buttons -->
  <DockPanel Margin="26,40,26,22">

    <!-- Hero: slim single-band header — bot | wordmark | utility cluster.
         Doubles as the window drag handle now that the title bar is gone. -->
    <Border DockPanel.Dock="Top"
            Name="HeroBand"
            PointerPressed="OnHeroPressed"
            CornerRadius="18"
            Padding="22,14"
            Margin="0,0,0,6"
            BorderBrush="#14FFFFFF"
            BorderThickness="1"
            BoxShadow="0 12 40 0 #59000000">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#B0142440" Offset="0" />
          <GradientStop Color="#B00E1A30" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <!-- Docked layout, not an overlay: the bot claims the left, the tools
           claim the right, and the wordmark centers inside whatever is left.
           Zones can shrink but they can never collide. -->
      <DockPanel LastChildFill="True">

        <!-- CTRL·BOT: the resident agent companion -->
        <StackPanel DockPanel.Dock="Left"
                    Orientation="Horizontal"
                    Spacing="12"
                    VerticalAlignment="Center"
                    DataContext="{Binding Buddy}"
                    x:DataType="gui:AgentBuddyViewModel">
          <Viewbox Height="88" Stretch="Uniform">
            <gui:BotView />
          </Viewbox>

          <!-- Speech bubble: fixed width so the text can never reflow the band -->
          <Border Background="#7A17243E"
                  BorderBrush="#14FFFFFF"
                  BorderThickness="1"
                  CornerRadius="14"
                  Padding="13,9"
                  Width="192"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding Message}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="#CFE1FF" />
          </Border>
        </StackPanel>

        <!-- Utility cluster: window-level tools, held in one segmented rail so
             they read as a single instrument rather than four loose words.
             The rail carries the chrome; the items inside stay quiet until
             hovered, and each pairs a glyph with its label so the row is
             scannable at a glance. -->
        <Border DockPanel.Dock="Right"
                VerticalAlignment="Center"
                Background="#4D0E1728"
                BorderBrush="#1FFFFFFF"
                BorderThickness="1"
                CornerRadius="13"
                Padding="4,3">
          <StackPanel Orientation="Horizontal" Spacing="1">
            <Button Classes="tool"
                    Click="OnShowMainframe"
                    ToolTip.Tip="Mainframe — fullscreen controller-first mode (F11, Xbox/PS button, or double-press View)">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock Text="⛶" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Text="Mainframe" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Rectangle Width="1" Fill="#14FFFFFF" Margin="3,5" />
            <Button Classes="tool" Click="OnToggleOverlay" ToolTip.Tip="Toggle the always-on-top HUD">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock Text="▤" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Text="Overlay" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Rectangle Width="1" Fill="#14FFFFFF" Margin="3,5" />
            <Button Classes="tool" Click="OnEditProfile" ToolTip.Tip="Edit controller bindings with live validation">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock Text="⚙" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Text="Profile" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Rectangle Width="1" Fill="#14FFFFFF" Margin="3,5" />
            <Button Classes="tool" Click="OnValidateHardware" ToolTip.Tip="Run the guided hardware validation wizard">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock Text="◎" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Text="Validate" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <!-- Wordmark: centered in the space the other two zones leave behind -->
        <StackPanel Spacing="4"
                    Margin="12,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
          <Image Source="avares://CtrlAgent.Gui/Assets/logo.png"
                 Height="46"
                 HorizontalAlignment="Center"
                 RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock Text="FOR AI CODING AGENTS"
                     Classes="label"
                     FontSize="8.5"
                     LetterSpacing="2"
                     TextAlignment="Center"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Status: facts on top, session controls under them. One row could not
         hold both — four fact blocks plus the session id and four knobs want
         ~1250px while the card is 928px at the default window size, so the
         knobs simply drew on top of WORKSPACE and PROFILE. Splitting is the
         honest fix: the top line is what the session *is*, the bottom line is
         what you can change about it. Facts wrap rather than clip. -->
    <Border DockPanel.Dock="Top" Classes="card" Padding="20,11" Margin="0,4,0,0">
      <StackPanel Spacing="9">

        <!-- Hairlines carry an explicit Height: a WrapPanel gives each child
             its desired size, and a Rectangle with only a Width desires none. -->
        <WrapPanel ItemSpacing="22" LineSpacing="8">

          <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                     Fill="{Binding ControllerDotBrush}"
                     Classes.pulse="{Binding IsControllerSearching}" />
            <StackPanel Spacing="1">
              <TextBlock Text="CONTROLLER" Classes="label" FontSize="9" />
              <TextBlock Text="{Binding ControllerStatus}"
                         FontSize="13" FontWeight="Medium" Foreground="#E6EFFB"
                         TextTrimming="CharacterEllipsis" MaxWidth="230" />
            </StackPanel>
          </StackPanel>

          <Rectangle Width="1" Height="28" Fill="#14FFFFFF" VerticalAlignment="Center" />

          <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                     Fill="{Binding AgentDotBrush}"
                     Classes.pulse="{Binding IsAgentActive}" />
            <StackPanel Spacing="1">
              <TextBlock Text="AGENT" Classes="label" FontSize="9" />
              <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock Text="{Binding AgentStatus}"
                           FontSize="13" FontWeight="Medium" Foreground="#E6EFFB" />
                <TextBlock Text="{Binding AgentState}" FontSize="13" Foreground="#7DD3FC" />
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <Rectangle Width="1" Height="28" Fill="#14FFFFFF" VerticalAlignment="Center" />

          <!-- Workspace: which repository the agent is pointed at. Clickable,
               because "which repo am I in" is the question you ask most and
               switching used to mean restarting the app. -->
          <Button Classes="ghost"
                  Padding="0"
                  Command="{Binding PickWorkspaceCommand}"
                  VerticalAlignment="Center"
                  Cursor="Hand"
                  ToolTip.Tip="{Binding WorkspacePath}">
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
              <TextBlock Text="🗂" FontSize="12" VerticalAlignment="Center" Foreground="#6B84AD" />
              <StackPanel Spacing="1">
                <TextBlock Text="WORKSPACE" Classes="label" FontSize="9" />
                <TextBlock Text="{Binding WorkspaceName}"
                           FontSize="13" FontWeight="Medium" Foreground="#E6EFFB"
                           TextTrimming="CharacterEllipsis" MaxWidth="150" />
              </StackPanel>
            </StackPanel>
          </Button>

          <Rectangle Width="1" Height="28" Fill="#14FFFFFF" VerticalAlignment="Center" />

          <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding ProfileDotBrush}" />
            <StackPanel Spacing="1">
              <TextBlock Text="PROFILE" Classes="label" FontSize="9" />
              <TextBlock Text="{Binding ProfileName}"
                         FontSize="13" FontWeight="Medium" Foreground="#E6EFFB" />
            </StackPanel>
          </StackPanel>

        </WrapPanel>

        <Rectangle Height="1" Fill="#14FFFFFF" />

        <!-- Session knobs: what the agent is running as, and the only row in
             this card you can click. Every one is also a controller binding,
             so the labels read from the engine rather than from a local
             counter (see PermissionModeLabel). -->
        <DockPanel LastChildFill="False">
          <TextBlock DockPanel.Dock="Left"
                     Text="{Binding SessionId}"
                     FontSize="11" Foreground="#4C6A93"
                     FontFamily="Cascadia Mono,Consolas,monospace"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" MaxWidth="260" />
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
            <Button Content="{Binding PermissionModeLabel}"
                    Command="{Binding CyclePermissionModeCommand}"
                    Classes="knob"
                    ToolTip.Tip="Cycle the agent's permission mode: default, plan, acceptEdits, auto, dontAsk" />
            <Button Content="{Binding ModelLabel}"
                    Command="{Binding CycleModelCommand}"
                    Classes="knob"
                    ToolTip.Tip="Cycle the model: default, sonnet, opus, haiku, fable" />
            <Button Content="{Binding EffortLabel}"
                    Command="{Binding CycleEffortCommand}"
                    Classes="knob"
                    ToolTip.Tip="Cycle reasoning effort: low, medium, high, xhigh, max" />
            <Button Content="compact"
                    Command="{Binding CompactCommand}"
                    Classes="knob"
                    ToolTip.Tip="Compact the conversation, freeing context" />
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- Action row: the only always-visible command strip -->
    <DockPanel DockPanel.Dock="Top" Margin="0,14,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="6,0,0,0"
                  VerticalAlignment="Bottom">
        <Border Background="#33FFB020"
                BorderBrush="#66FFB020"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8,2"
                VerticalAlignment="Center"
                IsVisible="{Binding HasQueuedPrompts}"
                ToolTip.Tip="Prompts waiting to send when the current turn ends">
          <TextBlock Text="{Binding QueuedPromptLabel}" FontSize="10" Foreground="#FFD9A0" />
        </Border>
        <!-- Dictation lands in the prompt box for review, never auto-sends;
             clicking again while listening cancels. -->
        <Button Content="🎙"
                Classes="ghost"
                Classes.listening="{Binding IsDictating}"
                Command="{Binding DictateCommand}"
                ToolTip.Tip="Dictate into the prompt box (click again to cancel)">
          <Button.Styles>
            <Style Selector="Button.listening">
              <Setter Property="BorderBrush" Value="#99FF5A78" />
              <Setter Property="Background" Value="#26FF5A78" />
            </Style>
          </Button.Styles>
        </Button>
        <Button Content="Submit" Classes="accent" Command="{Binding SubmitPromptCommand}" />
        <Button Content="Interrupt" Command="{Binding InterruptCommand}" />
        <Button Content="Review" Command="{Binding ReviewCommand}" />
        <Button Content="New session" Command="{Binding NewSessionCommand}" />
      </StackPanel>
      <!-- Multi-line: a coding agent gets pasted stack traces and numbered
           steps, and a single-line box silently flattened them. Enter still
           submits (handled in code-behind so it beats the newline insert);
           Shift+Enter is the newline. The box grows to a few lines, then
           scrolls, so a long paste never eats the window. -->
      <TextBox Text="{Binding PromptText}"
               FontSize="14"
               Padding="14,10"
               AcceptsReturn="True"
               AcceptsTab="False"
               TextWrapping="Wrap"
               MaxHeight="132"
               VerticalContentAlignment="Top"
               x:Name="PromptBox"
               Watermark="Ask the agent anything — Enter submits, Shift+Enter for a new line" />
    </DockPanel>

    <!-- Approval banner: docked in the flow directly under the prompt row, so
         it pushes content down rather than covering the controls you need to
         answer with. It kept a hardcoded top margin when it floated, which
         landed it on top of the prompt row at every window size. -->
    <Border DockPanel.Dock="Top"
            Classes="alert approvalBanner"
            Classes.show="{Binding HasPendingApproval}"
            Margin="0,12,0,0"
            Padding="14,10"
            BoxShadow="0 6 28 0 #66FFB020"
            IsVisible="{Binding HasPendingApproval}">
      <!-- Buttons dock right and keep their full width; the message takes
           whatever is left. A fixed-width message pushed Cancel off the edge
           of the banner — the one control you need to stop a bad write. -->
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Spacing="6"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center">
          <Button Content="Approve once" Classes="approve" Command="{Binding ApproveOnceCommand}" />
          <Button Content="Approve for session" Classes="approve" Command="{Binding ApproveSessionCommand}" />
          <Button Content="Decline" Classes="deny" Command="{Binding DeclineCommand}" />
          <Button Content="Cancel" Classes="deny" Command="{Binding CancelCommand}" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Left"
                   Text="APPROVAL REQUIRED"
                   Classes="label"
                   Foreground="#FFD9A0"
                   Opacity="1"
                   Margin="0,0,10,0"
                   VerticalAlignment="Center" />
        <TextBlock Text="{Binding PendingApprovalMessage}"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis"
                   MaxLines="2"
                   Foreground="#FFEFD6" />
      </DockPanel>
    </Border>

    <!-- Sessions + log + live input + bindings -->
    <Grid ColumnDefinitions="Auto,3*,2*" Margin="0,14,0,0">

      <!-- Recents sidebar (Claude-app style): every session the agent's
           on-disk store knows for this workspace, newest first — click one to
           resume it. Auto column, so hiding it (non-Claude adapters have no
           readable store yet) collapses the space entirely. -->
      <Border Grid.Column="0"
              Classes="card"
              Padding="12,14"
              Margin="0,0,9,0"
              Width="212"
              IsVisible="{Binding IsSessionListVisible}">
        <Border.Styles>
          <Style Selector="Button.sessionRow">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="CornerRadius" Value="8" />
          </Style>
          <Style Selector="Button.sessionRow.current">
            <Setter Property="BorderBrush" Value="#5900D4FF" />
            <Setter Property="Background" Value="#1400D4FF" />
          </Style>
        </Border.Styles>
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="4,0,0,8">
            <Button DockPanel.Dock="Right"
                    Content="↻"
                    Classes="ghost"
                    Padding="7,2"
                    Command="{Binding RefreshSessionsCommand}"
                    ToolTip.Tip="Refresh the session list" />
            <TextBlock Text="SESSIONS" Classes="label" VerticalAlignment="Center" />
          </DockPanel>
          <Button DockPanel.Dock="Top"
                  Content="+ New chat"
                  Classes="accent"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Margin="0,0,0,10"
                  Command="{Binding NewSessionCommand}" />
          <Panel>
            <TextBlock Classes="placeholder"
                       Text="No sessions yet"
                       IsVisible="{Binding IsSessionsEmpty}" />
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Sessions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="gui:SessionListItem">
                    <Button Classes="ghost sessionRow"
                            Classes.current="{Binding IsCurrent}"
                            Command="{Binding ResumeCommand}"
                            ToolTip.Tip="{Binding SessionId}">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Title}"
                                   TextWrapping="Wrap"
                                   MaxLines="2"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="11.5"
                                   Foreground="#D7E4FA" />
                        <TextBlock Text="{Binding WhenLabel}"
                                   FontSize="10"
                                   Foreground="#5A7099" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Panel>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Classes="card" Padding="16,14" Margin="0,0,9,0">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="4,0,0,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
              <ToggleButton Classes="chip"
                            Content="conversation"
                            IsChecked="{Binding IsChatView}"
                            ToolTip.Tip="Toggle between the conversation and the raw event stream" />
              <ToggleButton Classes="chip"
                            Content="controller input"
                            IsChecked="{Binding ShowControllerEvents}"
                            IsVisible="{Binding !IsChatView}"
                            ToolTip.Tip="Show or hide raw controller input lines" />
            </StackPanel>
            <TextBlock Text="ACTIVITY" Classes="label" VerticalAlignment="Center" />
          </DockPanel>
          <Panel>

          <!-- Conversation: what you said, what the agent replied, and what
               it did in between -->
          <Panel IsVisible="{Binding IsChatView}">
          <!-- Empty state: one quiet line and one hint, centered in the
               space. A long sentence floating in a void reads as an error. -->
          <StackPanel Spacing="7"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsVisible="{Binding IsTranscriptEmpty}">
            <Ellipse Width="34" Height="34" HorizontalAlignment="Center"
                     Fill="#12FFFFFF" Stroke="#1FFFFFFF" StrokeThickness="1" />
            <TextBlock Text="Nothing yet"
                       FontSize="13"
                       Foreground="#7B93BC"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Type a prompt, or press A on the controller"
                       FontSize="11.5"
                       Foreground="#4C6A93"
                       HorizontalAlignment="Center" />
          </StackPanel>
          <ListBox x:Name="ChatList"
                   Classes="chat"
                   ItemsSource="{Binding Transcript}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="gui:ChatMessage">
                <Panel>
                  <TextBlock Classes="activityRow"
                             Text="{Binding Text}"
                             TextWrapping="Wrap"
                             IsVisible="{Binding IsActivity}" />
                  <Border Classes="bubble"
                          Classes.user="{Binding IsUser}"
                          IsVisible="{Binding !IsActivity}">
                    <gui:MarkdownView Markdown="{Binding Text}" />
                  </Border>
                </Panel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          </Panel>

          <Panel IsVisible="{Binding !IsChatView}">
          <TextBlock Classes="placeholder"
                     Text="No events yet — controller and agent activity will stream here."
                     IsVisible="{Binding IsLogEmpty}" />
          <ListBox x:Name="EventStream"
                   ItemsSource="{Binding Log}"
                   FontFamily="Cascadia Mono,Consolas,monospace"
                   FontSize="12">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="MinHeight" Value="0" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="gui:LogEntry">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Timestamp}" Foreground="#5A7099" />
                  <TextBlock Text="{Binding Message}"
                             Foreground="{Binding Brush}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          </Panel>

          </Panel>
        </DockPanel>
      </Border>

      <!-- Proportional rows, not Top-docked + fill. Docked, the mirror card
           took its full desired height first, so on a short window it ate the
           whole column: ACTIVE BINDINGS disappeared entirely and the mirror
           drew straight over the HAPTICS chips. Stars mean both cards always
           get a share and the mirror scales into whatever it is given. -->
      <Grid Grid.Column="2" Margin="9,0,0,0" RowDefinitions="3*,2*">

        <!-- Live controller mirror: every control lights up as it is used -->
        <Border Grid.Row="0" Classes="card" Padding="16,14" Margin="0,0,0,9">
          <DockPanel>

            <!-- Haptic preview chips: fire a pattern on the mirrored controller -->
            <WrapPanel DockPanel.Dock="Bottom" Margin="4,8,0,0" ItemSpacing="1" LineSpacing="2">
              <WrapPanel.Styles>
                <Style Selector="Button">
                  <Setter Property="FontSize" Value="11" />
                  <Setter Property="Padding" Value="8,3" />
                </Style>
              </WrapPanel.Styles>
              <TextBlock Text="HAPTICS" Classes="label" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Button Content="Working" Classes="ghost" Command="{Binding PlayPatternCommand}" CommandParameter="working" />
              <Button Content="Approval" Classes="ghost" Command="{Binding PlayPatternCommand}" CommandParameter="approval" />
              <Button Content="Waiting" Classes="ghost" Command="{Binding PlayPatternCommand}" CommandParameter="waiting" />
              <Button Content="Completed" Classes="ghost" Command="{Binding PlayPatternCommand}" CommandParameter="completed" />
              <Button Content="Error" Classes="ghost" Command="{Binding PlayPatternCommand}" CommandParameter="error" />
              <Button Content="Stop" Classes="ghost" Foreground="#E08496" Command="{Binding PlayPatternCommand}" CommandParameter="stop" />
            </WrapPanel>

          <!-- DockPanel, not StackPanel: a StackPanel hands each child its
               full desired height and never compresses, so the mirror spilled
               over the haptics row instead of shrinking. Here it fills what is
               left and its Viewbox scales to fit. -->
          <DockPanel DataContext="{Binding ControllerVisual}" x:DataType="gui:ControllerVisualViewModel">
            <TextBlock DockPanel.Dock="Top" Text="LIVE INPUT" Classes="label" Margin="4,0,0,6" />
            <!-- Elite Series 2 layout: asymmetric Xbox sticks, hybrid d-pad
                 disc, notched stick rings, guide button, rear paddle blades. -->
            <gui:ControllerMirrorView MaxHeight="230" />
          </DockPanel>
          </DockPanel>
        </Border>

        <Border Grid.Row="1" Classes="card" Padding="16,14">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="ACTIVE BINDINGS" Classes="label" Margin="4,0,0,6" />
            <Panel>
            <TextBlock Classes="placeholder"
                       Text="No bindings — open Profile… to add some."
                       IsVisible="{Binding IsBindingsEmpty}" />
            <ListBox ItemsSource="{Binding Bindings}" FontSize="12">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="6,3" />
                  <Setter Property="MinHeight" Value="0" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="gui:BindingRow">
                  <DockPanel>
                    <Border DockPanel.Dock="Left"
                            Background="#4D0E1728"
                            BorderBrush="#1FFFFFFF"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="6,2"
                            MinWidth="84"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding Chord}"
                                 FontFamily="Cascadia Mono,Consolas,monospace"
                                 FontSize="11"
                                 Foreground="#7DD3FC"
                                 HorizontalAlignment="Center" />
                    </Border>
                    <Border DockPanel.Dock="Right"
                            Background="#33FFB020"
                            CornerRadius="4"
                            Padding="5,1"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsApproval}">
                      <TextBlock Text="approval" FontSize="9" Foreground="#FFD9A0" />
                    </Border>
                    <TextBlock Text="{Binding Action}"
                               Margin="8,0"
                               VerticalAlignment="Center"
                               Foreground="#B9CCEF" />
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            </Panel>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>

  </DockPanel>

  <!-- Startup failure: a dead app must say so. This sits above everything
       because the window otherwise looks merely disconnected, and the real
       reason used to be reachable only by toggling to the event stream. -->
  <Border IsVisible="{Binding HasStartupError}"
          Background="#F0060B14"
          Padding="28">
    <Border Classes="card"
            MaxWidth="560"
            Padding="24"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Background="#241016"
            BorderBrush="#80FF5A78">
      <StackPanel Spacing="12">
        <TextBlock Text="CTRLAGENT COULDN'T START"
                   Classes="label"
                   FontSize="12"
                   Foreground="#FF9AA8"
                   HorizontalAlignment="Center" />
        <TextBlock Text="{Binding StartupError}"
                   FontSize="13"
                   Foreground="#FFD9DF"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   TextAlignment="Center" />
        <TextBlock Text="Nothing is connected and no bindings are active until this is resolved. If you passed command-line flags, check that any path containing spaces is quoted."
                   FontSize="11.5"
                   Foreground="#9FB7DF"
                   TextWrapping="Wrap" />
        <Button Content="Change settings…"
                Classes="accent"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Command="{Binding DismissStartupErrorCommand}" />
      </StackPanel>
    </Border>
  </Border>

  <!-- Guide-button confirmation. The Xbox button is easy to catch with a palm
       and Mainframe takes the whole screen, so it asks first. -->
  <Border IsVisible="{Binding IsMainframePromptVisible}" Background="#E0060B14">
    <Border Classes="card"
            MaxWidth="440"
            Padding="26"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
      <StackPanel Spacing="14">
        <TextBlock Text="ENTER MAINFRAME?"
                   Classes="label"
                   FontSize="12"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Mainframe takes over the full screen and the controller drives it."
                   FontSize="12.5"
                   Foreground="#9FB7DF"
                   TextWrapping="Wrap"
                   TextAlignment="Center" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <Button Content="Enter"
                  Classes="accent"
                  MinWidth="120"
                  HorizontalContentAlignment="Center"
                  Command="{Binding ConfirmMainframeCommand}" />
          <Button Content="Stay here"
                  MinWidth="120"
                  HorizontalContentAlignment="Center"
                  Command="{Binding DismissMainframePromptCommand}" />
        </StackPanel>
        <TextBlock Text="A — enter     B — stay here"
                   Classes="label"
                   FontSize="10"
                   Opacity="0.75"
                   HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
  </Border>

  <!-- First-run setup overlay -->
  <Border IsVisible="{Binding IsSetupVisible}" Background="#E0060B14">
    <Border Classes="card" MaxWidth="480" Padding="26" VerticalAlignment="Center" HorizontalAlignment="Center">
      <StackPanel Spacing="12">
        <TextBlock Text="WELCOME TO CTRLAGENT" Classes="label" FontSize="12" HorizontalAlignment="Center" />
        <TextBlock Text="One-time setup: pick the agent to drive and the repository to work in. Saved for next launch — command-line flags always override."
                   FontSize="12"
                   Foreground="#9FB7DF"
                   TextWrapping="Wrap" />
        <TextBlock Text="Agent platform" FontSize="11" Opacity="0.6" />
        <ComboBox ItemsSource="{x:Static gui:MainViewModel.SetupAgents}"
                  SelectedItem="{Binding SetupAgent}"
                  HorizontalAlignment="Stretch" />
        <TextBlock Text="Working directory (your repository)" FontSize="11" Opacity="0.6" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Click="OnBrowseWorkingDirectory" />
          <TextBox Text="{Binding SetupWorkingDirectory}" />
        </DockPanel>
        <TextBlock Text="{Binding SetupError}"
                   Foreground="#FF7A6E"
                   FontSize="12"
                   TextWrapping="Wrap"
                   IsVisible="{Binding SetupError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Button Content="Start"
                Classes="accent"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Command="{Binding StartSetupCommand}" />
        <TextBlock Text="mock is the safe demo agent (no real AI calls). codex and claude need their CLI installed and authenticated."
                   FontSize="11"
                   Opacity="0.5"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Border>
  </Panel>
</Window>
