<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gui="using:CtrlAgent.Gui"
        x:Class="CtrlAgent.Gui.ProfileEditorWindow"
        x:DataType="gui:ProfileEditorViewModel"
        Title="CtrlAgent profile editor"
        Icon="avares://CtrlAgent.Gui/Assets/icon.png"
        Width="860"
        Height="600"
        MinWidth="700"
        MinHeight="460"
        WindowStartupLocation="CenterOwner">

  <DockPanel Margin="14">

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8">
      <TextBlock Text="Profile name:" VerticalAlignment="Center" />
      <TextBox Text="{Binding Name}" Width="220" />
      <Button Content="Add binding" Command="{Binding AddCommand}" />
      <Button Content="Remove selected" Classes="deny" Command="{Binding RemoveCommand}" />
    </StackPanel>

    <!-- Layers: capability-activated binding groups. A binding names a layer
         to only exist while that layer is active on the connected pad. -->
    <Border DockPanel.Dock="Top" Classes="card" Padding="8" Margin="0,10,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="LAYERS" Classes="label" VerticalAlignment="Center" />
          <Button Content="Add layer"
                  Command="{Binding AddLayerCommand}"
                  FontSize="11" Padding="9,3"
                  ToolTip.Tip="Layers activate by device capability: always, requiresPaddles, or withoutPaddles" />
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="10,0,0,0">
          <ItemsControl ItemsSource="{Binding Layers}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="gui:LayerEditor">
                <Border Background="#80141F36" BorderBrush="#1FFFFFFF" BorderThickness="1"
                        CornerRadius="8" Padding="6,3">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBox Text="{Binding Name}" Width="110" FontSize="12" />
                    <ComboBox ItemsSource="{x:Static gui:ProfileEditorViewModel.ActivationNames}"
                              SelectedItem="{Binding Activation}"
                              FontSize="12" />
                    <Button Content="✕"
                            FontSize="10" Padding="6,2"
                            Classes="deny"
                            Command="{Binding $parent[Window].((gui:ProfileEditorViewModel)DataContext).RemoveLayerCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="Remove this layer" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="8" Classes="card">
      <StackPanel Spacing="8">
        <ItemsControl ItemsSource="{Binding Errors}" MaxHeight="90">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" Foreground="#FF7A6E" TextWrapping="Wrap" FontSize="12" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Apply to running host" Classes="accent" IsEnabled="{Binding IsValid}" Click="OnApply" />
          <Button Content="Save as JSON…" IsEnabled="{Binding IsValid}" Click="OnSave" />
          <Button Content="Load JSON…" Click="OnLoad" />
          <Button Content="Close" Click="OnClose" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="5*,4*" Margin="0,10,0,0">
      <Border Padding="6" Classes="card" Margin="0,0,6,0">
        <ListBox ItemsSource="{Binding Bindings}" SelectedItem="{Binding SelectedBinding}" FontSize="12">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="gui:BindingEditor">
              <TextBlock Text="{Binding Summary}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Column="1"
              Padding="10"
              Classes="card"
              Margin="6,0,0,0"
              IsEnabled="{Binding SelectedBinding, Converter={x:Static ObjectConverters.IsNotNull}}">
        <ScrollViewer>
          <StackPanel DataContext="{Binding SelectedBinding}" x:DataType="gui:BindingEditor" Spacing="6">
            <TextBlock Text="Control" FontSize="11" Opacity="0.6" />
            <ComboBox ItemsSource="{x:Static gui:ProfileEditorViewModel.ControlNames}"
                      SelectedItem="{Binding Control}"
                      HorizontalAlignment="Stretch" />
            <TextBlock Text="Gesture" FontSize="11" Opacity="0.6" />
            <ComboBox ItemsSource="{x:Static gui:ProfileEditorViewModel.GestureNames}"
                      SelectedItem="{Binding Gesture}"
                      HorizontalAlignment="Stretch" />
            <TextBlock Text="Command" FontSize="11" Opacity="0.6" />
            <ComboBox ItemsSource="{x:Static gui:ProfileEditorViewModel.CommandNames}"
                      SelectedItem="{Binding Command}"
                      HorizontalAlignment="Stretch" />
            <TextBlock Text="Modifiers (e.g. LeftShoulder+RightShoulder)" FontSize="11" Opacity="0.6" />
            <TextBox Text="{Binding ModifiersText}" />
            <TextBlock Text="Hold ms (Tap/Hold, default 400)" FontSize="11" Opacity="0.6" />
            <TextBox Text="{Binding HoldMilliseconds}" />
            <TextBlock Text="Double-press ms (default 300)" FontSize="11" Opacity="0.6" />
            <TextBox Text="{Binding DoublePressMilliseconds}" />
            <TextBlock Text="Axis minimum value (AxisThreshold)" FontSize="11" Opacity="0.6" />
            <TextBox Text="{Binding MinimumValue}" />
            <TextBlock Text="Prompt text (SubmitPrompt)" FontSize="11" Opacity="0.6" />
            <TextBox Text="{Binding Text}" AcceptsReturn="False" />
            <TextBlock Text="Layer (optional; must name a declared layer)" FontSize="11" Opacity="0.6" />
            <TextBox Text="{Binding Layer}" />
            <CheckBox Content="Requires pending approval" IsChecked="{Binding RequiresPendingApproval}" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

  </DockPanel>
</Window>
