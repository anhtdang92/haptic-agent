<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gui="using:CtrlAgent.Gui"
        x:Class="CtrlAgent.Gui.WorkspaceWindow"
        Title="Workspace"
        Icon="avares://CtrlAgent.Gui/Assets/icon.png"
        WindowStartupLocation="CenterOwner"
        Width="620"
        Height="440"
        MinWidth="480"
        MinHeight="340">

  <DockPanel Margin="22,20">

    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,16">
      <TextBlock Text="WORKSPACE" Classes="label" />
      <TextBlock Text="The directory the agent works in. Switching restarts the agent — the controller, profile and settings carry over, the conversation does not."
                 FontSize="12"
                 Foreground="#7B93BC"
                 TextWrapping="Wrap" />
    </StackPanel>

    <!-- Actions pinned to the bottom so the list can grow -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Browse…" Click="OnBrowse" />
      <Button Content="Open" Classes="accent" Click="OnOpenSelected" />
      <Button Content="Cancel" Classes="ghost" Click="OnCancel" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,12">
      <TextBlock Text="CURRENT" Classes="label" FontSize="9" />
      <Border Classes="card" Padding="12,9">
        <TextBlock x:Name="CurrentPath"
                   FontFamily="Cascadia Mono,Consolas,monospace"
                   FontSize="12"
                   Foreground="#9FD8F2"
                   TextTrimming="CharacterEllipsis" />
      </Border>
    </StackPanel>

    <Border Classes="card" Padding="8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="RECENT" Classes="label" FontSize="9" Margin="6,4,0,6" />
        <Panel>
          <TextBlock Classes="placeholder"
                     x:Name="EmptyHint"
                     Text="No other workspaces yet — use Browse… to pick one." />
          <ListBox x:Name="RecentList" DoubleTapped="OnOpenSelected">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="gui:WorkspaceEntry">
                <StackPanel Spacing="1" Margin="2,3">
                  <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#E4EEFF" />
                  <TextBlock Text="{Binding Path}"
                             FontSize="11"
                             Foreground="#5A7099"
                             FontFamily="Cascadia Mono,Consolas,monospace"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Panel>
      </DockPanel>
    </Border>
  </DockPanel>
</Window>
