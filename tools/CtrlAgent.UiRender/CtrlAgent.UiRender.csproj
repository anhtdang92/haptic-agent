<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless UI render harness. The GUI targets net10.0-windows, so it
       cannot run on a build agent or a Linux dev box; this project compiles
       the same XAML and view models against a cross-platform TFM and renders
       the windows to PNG with Avalonia's headless Skia platform. It exists to
       catch layout regressions (clipped controls, empty panels, off-screen
       focus) without a Windows desktop.

       Deliberately NOT in CtrlAgent.sln: like the native bridge, it is a
       side tool and must not affect normal builds.

       Run it with "dotnet run" against this project file; PNGs land in
       ./shots, or wherever UIRENDER_OUT points. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Must match the GUI assembly so avares://CtrlAgent.Gui/... asset URIs
         inside the XAML resolve against this assembly. -->
    <AssemblyName>CtrlAgent.Gui</AssemblyName>
    <RootNamespace>CtrlAgent.Gui</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0067;AVLN2000</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <GuiDir>$(MSBuildThisFileDirectory)../../src/CtrlAgent.Gui</GuiDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- The real GUI sources, minus the Windows-only host bootstrap and the
         System.Speech dictation service (both stubbed in Harness.cs). -->
    <Compile Include="$(GuiDir)/*.cs"
             Exclude="$(GuiDir)/App.axaml.cs;$(GuiDir)/Program.cs;$(GuiDir)/SpeechToTextService.cs" />
    <Compile Include="Harness.cs" />
    <AvaloniaXaml Include="$(GuiDir)/*.axaml" />
    <AvaloniaResource Include="$(GuiDir)/Assets/icon.png" Link="Assets/icon.png" />
    <AvaloniaResource Include="$(GuiDir)/Assets/logo.png" Link="Assets/logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.18" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.18" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../src/CtrlAgent.Core/CtrlAgent.Core.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../src/CtrlAgent.Hosting/CtrlAgent.Hosting.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../src/CtrlAgent.Adapters.Mock/CtrlAgent.Adapters.Mock.csproj" />
  </ItemGroup>

</Project>
