<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CtrlAgent.Gui</AssemblyName>
    <RootNamespace>CtrlAgent.Gui</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0067;AVLN2000</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <GuiDir>$(MSBuildThisFileDirectory)../../src/CtrlAgent.Gui</GuiDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(GuiDir)/*.cs"
             Exclude="$(GuiDir)/App.axaml.cs;$(GuiDir)/Program.cs;$(GuiDir)/SpeechToTextService.cs;$(GuiDir)/FocusModeOverlay.cs;$(GuiDir)/FocusModeBootstrap.cs;$(GuiDir)/HapticEventCoordinator.cs" />
    <Compile Include="Harness.cs" />
    <Compile Include="FocusModeHarnessStubs.cs" />
    <AvaloniaXaml Include="$(GuiDir)/*.axaml" />
    <AvaloniaResource Include="$(GuiDir)/Assets/icon.png" Link="Assets/icon.png" />
    <AvaloniaResource Include="$(GuiDir)/Assets/logo.png" Link="Assets/logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.18" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.18" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../src/CtrlAgent.Core/CtrlAgent.Core.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../src/CtrlAgent.Hosting/CtrlAgent.Hosting.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../src/CtrlAgent.Presentation/CtrlAgent.Presentation.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../src/CtrlAgent.Adapters.Mock/CtrlAgent.Adapters.Mock.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../src/CtrlAgent.Adapters.ClaudeCode/CtrlAgent.Adapters.ClaudeCode.csproj" />
  </ItemGroup>
</Project>
